<!-- Page Header Start -->
<div class="container-fluid page-header py-5 mb-5 wow fadeIn" data-wow-delay="0.1s">
    <div class="container text-center py-5">
        <h1 class="display-4 text-white animated slideInDown mb-3"><%= artisan.user ? artisan.user.name : 'Vetted Artisan' %></h1>
        <nav aria-label="breadcrumb animated slideInDown">
            <ol class="breadcrumb justify-content-center mb-0">
                <li class="breadcrumb-item"><a class="text-white" href="/">Home</a></li>
                <li class="breadcrumb-item"><a class="text-white" href="/fundis">Hire Fundi</a></li>
                <li class="breadcrumb-item text-primary active" aria-current="page"><%= artisan.user ? artisan.user.name : 'Artisan' %></li>
            </ol>
        </nav>
    </div>
</div>
<!-- Page Header End -->

<div class="container-xxl py-4">
    <div class="container">
        <div class="row g-5">
            <!-- Left Column: Artisan Profile & Bio -->
            <div class="col-lg-7">
                <!-- Profile Header Card -->
                <div class="card border-0 shadow-sm p-4 bg-white mb-4">
                    <div class="d-flex flex-wrap align-items-center gap-4">
                        <img src="<%= artisan.user && artisan.user.avatar ? artisan.user.avatar : '/img/team-1.jpg' %>" alt="<%= artisan.user ? artisan.user.name : 'Artisan' %>" class="rounded-circle border border-3 border-primary" style="width: 110px; height: 110px; object-fit: cover;">
                        <div>
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                <h3 class="fw-bold text-dark mb-0"><%= artisan.user ? artisan.user.name : 'Artisan Specialist' %></h3>
                                <% if (artisan.user && artisan.user.is_verified) { %>
                                    <span class="badge bg-success"><i class="fa fa-shield-alt me-1"></i>Verified Tradesman</span>
                                <% } %>
                            </div>
                            <div class="text-primary fw-bold fs-5 mb-2"><%= artisan.trade %></div>
                            <div class="text-muted small d-flex flex-wrap gap-3">
                                <span><i class="fa fa-map-marker-alt text-primary me-1"></i><%= artisan.user ? artisan.user.town + ', ' + artisan.user.county : 'Kenya' %></span>
                                <span><i class="fa fa-star text-warning me-1"></i><%= artisan.rating || '5.0' %> / 5.0 Site Rating</span>
                                <% if (artisan.nca_reg_number) { %>
                                    <span><i class="fa fa-certificate text-primary me-1"></i>NCA Reg: <strong><%= artisan.nca_reg_number %></strong></span>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Stats Strip -->
                <div class="row g-3 mb-4">
                    <div class="col-4">
                        <div class="p-3 bg-light rounded text-center border-0">
                            <div class="fs-4 fw-bold text-primary"><%= artisan.experience_years %>+</div>
                            <small class="text-muted">Years Experience</small>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-3 bg-light rounded text-center border-0">
                            <div class="fs-4 fw-bold text-dark">Ksh <%= Number(artisan.daily_rate).toLocaleString() %></div>
                            <small class="text-muted">Daily Rate</small>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-3 bg-light rounded text-center border-0">
                            <div class="fs-4 fw-bold <%= artisan.is_available ? 'text-success' : 'text-secondary' %>">
                                <%= artisan.is_available ? 'Available' : 'Booked' %>
                            </div>
                            <small class="text-muted">Site Availability</small>
                        </div>
                    </div>
                </div>

                <!-- Bio & Trade Scope -->
                <div class="card border-0 shadow-sm p-4 bg-white mb-4">
                    <h4 class="fw-bold text-dark mb-3">Professional Background & Scope</h4>
                    <p class="text-muted leading-relaxed mb-4" style="font-size: 1.05rem;">
                        <%= artisan.bio || 'Certified trades specialist operating with established workmanship standards on Kenyan building and civil engineering works.' %>
                    </p>

                    <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">Verification & Compliance Badges</h5>
                    <ul class="list-unstyled mb-0 text-secondary">
                        <li class="mb-2 d-flex align-items-center">
                            <i class="fa fa-check-circle text-success me-2"></i>
                            <span>National Construction Authority (NCA) Registered or Trade-Tested</span>
                        </li>
                        <li class="mb-2 d-flex align-items-center">
                            <i class="fa fa-check-circle text-success me-2"></i>
                            <span>National Identity & Phone Verified Tradesperson</span>
                        </li>
                        <li class="mb-2 d-flex align-items-center">
                            <i class="fa fa-check-circle text-success me-2"></i>
                            <span>Tooling & Equipment Capable for Residential & Commercial Works</span>
                        </li>
                        <li class="mb-0 d-flex align-items-center">
                            <i class="fa fa-check-circle text-success me-2"></i>
                            <span>Direct Kenyan WhatsApp & Phone Contact Enabled</span>
                        </li>
                    </ul>
                </div>

                <!-- Client Project Promo Banner -->
                <div class="bg-dark p-4 rounded text-white d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div>
                        <h5 class="text-white mb-1">Have a Large Construction Project?</h5>
                        <small class="text-secondary">Post your project details to receive bids from multiple vetted teams.</small>
                    </div>
                    <a href="/jobs/post" class="btn btn-primary text-white fw-bold btn-sm"><i class="fa fa-plus me-1"></i>Post Project</a>
                </div>
            </div>

            <!-- Right Column: Direct Booking & Contact -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm p-4 bg-white sticky-top" style="top: 100px;">
                    <div class="border-start border-4 border-primary ps-3 mb-3">
                        <h4 class="fw-bold text-dark mb-0">Hire <%= artisan.user ? artisan.user.name : 'This Fundi' %></h4>
                        <small class="text-muted">Direct Site Booking & Instant WhatsApp Connect</small>
                    </div>

                    <div class="p-3 bg-light rounded mb-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">Standard Labor Rate:</small>
                            <span class="fs-5 fw-bold text-primary">Ksh <%= Number(artisan.daily_rate).toLocaleString() %> / Day</span>
                        </div>
                    </div>

                    <!-- Quick Contact Buttons -->
                    <div class="d-grid gap-2 mb-4">
                        <% if (artisan.contactUnlocked) { %>
                            <% 
                                const artisanPhone = artisan.user ? artisan.user.phone.replace(/[^0-9]/g, '') : '254711000000';
                                const waClean = artisanPhone.startsWith('0') ? '254' + artisanPhone.slice(1) : artisanPhone;
                                const waDirectMsg = encodeURIComponent('Hi ' + (artisan.user ? artisan.user.name : 'Fundi') + ', I found your ' + artisan.trade + ' profile on TopLineHub Kenya. Are you available for site work?');
                            %>
                            <a href="https://wa.me/<%= waClean %>?text=<%= waDirectMsg %>" target="_blank" class="btn btn-whatsapp py-3 fw-bold">
                                <i class="fab fa-whatsapp me-2"></i>Chat on WhatsApp Directly
                            </a>
                            <% if (artisan.user && artisan.user.phone) { %>
                                <a href="tel:<%= artisan.user.phone %>" class="btn btn-outline-dark py-2">
                                    <i class="fa fa-phone me-2"></i>Call Directly (<%= artisan.user.phone %>)
                                </a>
                            <% } %>
                        <% } else { %>
                            <div class="card bg-light border p-3 text-center">
                                <div class="text-muted small mb-2">
                                    <i class="fa fa-lock text-warning me-1"></i>Fundi direct phone & WhatsApp are protected.
                                </div>
                                <div class="mb-2">
                                    <span class="badge bg-white text-muted border py-2 px-3"><%= artisan.maskedPhone %></span>
                                </div>
                                <form action="/unlock/artisan/<%= artisan.id %>" method="POST">
                                    <button type="submit" class="btn btn-warning py-2 w-100 fw-bold text-dark shadow-sm">
                                        <i class="fa fa-unlock-alt me-1"></i>Unlock WhatsApp & Direct Phone (Ksh <%= artisan.unlockPrice %>)
                                    </button>
                                </form>
                            </div>
                        <% } %>
                    </div>

                    <!-- Formal Project Inquiry Form -->
                    <div class="border-top pt-3">
                        <h6 class="fw-bold text-dark mb-3"><i class="fa fa-clipboard-check text-primary me-2"></i>Send Project Brief</h6>
                        <form action="/fundis/<%= artisan.id %>/inquiry" method="POST">
                            <div class="mb-2">
                                <label class="form-label small fw-bold text-dark mb-1">Your Name *</label>
                                <input type="text" name="client_name" class="form-control form-control-sm bg-light" placeholder="Site Owner / Foreperson" value="<%= user ? user.name : '' %>" required>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small fw-bold text-dark mb-1">Your Phone / WhatsApp *</label>
                                <input type="tel" name="client_phone" class="form-control form-control-sm bg-light" placeholder="0711000000" value="<%= user ? user.phone : '' %>" required>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small fw-bold text-dark mb-1">Site Location (Town / County) *</label>
                                <input type="text" name="location" class="form-control form-control-sm bg-light" placeholder="e.g. Ruiru, Kiambu" value="<%= user ? user.town : '' %>" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-dark mb-1">Project Scope & Dates *</label>
                                <textarea name="project_scope" rows="3" class="form-control form-control-sm bg-light" placeholder="e.g. 5 days masonry for boundary wall foundation..." required></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary w-100 py-2 text-white fw-bold btn-sm shadow-sm">
                                <i class="fa fa-paper-plane me-1"></i>Send Brief & Open WhatsApp
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Similar Tradesmen Section -->
        <% if (similarArtisans && similarArtisans.length > 0) { %>
            <div class="mt-5 pt-4 border-top">
                <div class="border-start border-5 border-primary ps-4 mb-4">
                    <h6 class="text-body text-uppercase mb-1">Alternative Tradesmen</h6>
                    <h3 class="mb-0">More Vetted Artisans Available</h3>
                </div>
                <div class="row g-4">
                    <% similarArtisans.forEach(sim => { %>
                        <div class="col-md-6 col-lg-4">
                            <div class="card card-custom h-100 bg-white p-4 border-0 shadow-sm">
                                <div class="d-flex align-items-center mb-3">
                                    <img src="<%= sim.user && sim.user.avatar ? sim.user.avatar : '/img/team-1.jpg' %>" class="rounded-circle me-3 border border-2 border-primary" style="width: 60px; height: 60px; object-fit: cover;" alt="<%= sim.user ? sim.user.name : 'Artisan' %>">
                                    <div>
                                        <h5 class="fw-bold mb-0 text-dark"><%= sim.user ? sim.user.name : 'Artisan' %></h5>
                                        <span class="badge-trade"><%= sim.trade %></span>
                                    </div>
                                </div>
                                <div class="text-muted small mb-3">
                                    <i class="fa fa-map-marker-alt text-primary me-1"></i><%= sim.user ? sim.user.town + ', ' + sim.user.county : 'Kenya' %>
                                </div>
                                <div class="product-price mb-3 mt-auto">
                                    Ksh <%= Number(sim.daily_rate).toLocaleString() %> <span class="small">/ Day</span>
                                </div>
                                <a href="/fundis/<%= sim.id %>" class="btn btn-outline-primary btn-sm fw-bold">
                                    View Profile & Rates
                                </a>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        <% } %>
    </div>
</div>

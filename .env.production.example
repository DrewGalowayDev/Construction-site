# Production Environment Variables
# Copy this file to .env or set these in Coolify UI

# Application
NODE_ENV=production
PORT=3000
APP_URL=https://yourdomain.com

# Database - Update with your actual credentials
DB_HOST=topline-db
DB_PORT=3306
DB_NAME=construction
DB_USER=topline
DB_PASS=your-secure-database-password

# Session - Generate secure random string (min 32 characters)
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-very-secure-random-session-secret-here

# Paystack Payment Gateway
# Get from: https://dashboard.paystack.com/#/settings/api
# Use test keys for testing, live keys for production
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_CURRENCY=KES

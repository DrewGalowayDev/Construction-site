<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Topline Construction</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .admin-table {
            width: 100%;
            border-collapse: collapse;
            background: #fff;
            border-radius: 8px;
            overflow: hidden;
        }
        .admin-table thead {
            background: #0b3a6e;
            color: #fff;
        }
        .admin-table th {
            padding: 12px;
            text-align: left;
            font-size: 13px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .admin-table td {
            padding: 12px;
            border-bottom: 1px solid #e5e7eb;
            font-size: 14px;
        }
        .admin-table tbody tr:hover {
            background: #f8f9fa;
        }
        .admin-table tbody tr:last-child td {
            border-bottom: none;
        }
        @media (max-width: 768px) {
            .admin-table {
                font-size: 12px;
            }
            .admin-table th,
            .admin-table td {
                padding: 8px;
            }
        }
    </style>
</head>
<body>

<div class="dashboard-container">
    <!-- Sidebar -->
    <aside class="dashboard-sidebar">
        <div class="sidebar-logo">
            <h2 style="color:var(--navy);margin:0">Topline Admin</h2>
        </div>
        <ul class="sidebar-nav">
            <li class="sidebar-nav-item">
                <a href="/dashboard/admin" class="sidebar-nav-link active">
                    <i class="fas fa-tachometer-alt"></i>
                    <span>Dashboard</span>
                </a>
            </li>
            <li class="sidebar-nav-item">
                <a href="#users" class="sidebar-nav-link">
                    <i class="fas fa-users"></i>
                    <span>Users</span>
                </a>
            </li>
            <li class="sidebar-nav-item">
                <a href="#providers" class="sidebar-nav-link">
                    <i class="fas fa-user-check"></i>
                    <span>Providers</span>
                </a>
            </li>
            <li class="sidebar-nav-item">
                <a href="#training" class="sidebar-nav-link">
                    <i class="fas fa-graduation-cap"></i>
                    <span>Training Payments</span>
                </a>
            </li>
            <li class="sidebar-nav-item">
                <a href="#products" class="sidebar-nav-link">
                    <i class="fas fa-boxes"></i>
                    <span>Products</span>
                </a>
            </li>
            <li class="sidebar-nav-item" style="margin-top:20px;border-top:1px solid #e5e7eb;padding-top:20px">
                <a href="/" class="sidebar-nav-link">
                    <i class="fas fa-home"></i>
                    <span>Home</span>
                </a>
            </li>
            <li class="sidebar-nav-item">
                <a href="/auth/logout" class="sidebar-nav-link" style="color:#dc2626">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>Logout</span>
                </a>
            </li>
        </ul>
    </aside>

    <!-- Main Content -->
    <main class="dashboard-main">
        <!-- Dashboard Header -->
        <div class="dashboard-header">
            <div>
                <h1><i class="fas fa-user-shield"></i> Admin Dashboard</h1>
                <p style="color:#6b7280;margin:4px 0 0">Manage users, verify providers, approve training payments</p>
            </div>
        </div>

        <!-- Stats Grid -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-card-header">
                    <div>
                        <div class="stat-card-title">Total Users</div>
                        <div class="stat-card-value"><%= users ? users.length : 0 %></div>
                    </div>
                    <div class="stat-card-icon" style="background:#fef3e2;color:#f5a623">
                        <i class="fas fa-users"></i>
                    </div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-card-header">
                    <div>
                        <div class="stat-card-title">Providers</div>
                        <div class="stat-card-value"><%= providers ? providers.length : 0 %></div>
                    </div>
                    <div class="stat-card-icon" style="background:#dbeafe;color:#1e40af">
                        <i class="fas fa-tools"></i>
                    </div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-card-header">
                    <div>
                        <div class="stat-card-title">Active Jobs</div>
                        <div class="stat-card-value"><%= allJobs ? allJobs.length : 0 %></div>
                    </div>
                    <div class="stat-card-icon" style="background:#e0e7ff;color:#4338ca">
                        <i class="fas fa-briefcase"></i>
                    </div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-card-header">
                    <div>
                        <div class="stat-card-title">Products</div>
                        <div class="stat-card-value"><%= allProducts ? allProducts.length : 0 %></div>
                    </div>
                    <div class="stat-card-icon" style="background:#d1fae5;color:#065f46">
                        <i class="fas fa-cubes"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Users Management -->
        <div class="content-section" id="users">
            <div class="content-section-header">
                <h2 class="content-section-title"><i class="fas fa-users-cog"></i> User Management</h2>
            </div>
            
            <% if (users && users.length > 0) { %>
                <div style="overflow-x:auto">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Role</th>
                                <th>Joined</th>
                                <th style="text-align:center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% users.slice(0, 20).forEach(user => { %>
                            <tr>
                                <td><%= user.id %></td>
                                <td style="font-weight:600"><%= user.name %></td>
                                <td><%= user.email %></td>
                                <td><%= user.phone || 'N/A' %></td>
                                <td>
                                    <span class="badge badge-info">
                                        <%= user.role || 'client' %>
                                    </span>
                                </td>
                                <td style="font-size:12px;color:#6b7280"><%= new Date(user.created_at).toLocaleDateString() %></td>
                                <td style="text-align:center">
                                    <button class="btn-sm btn-primary">
                                        <i class="fas fa-eye"></i> View
                                    </button>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <div class="empty-state-icon">
                        <i class="fas fa-users"></i>
                    </div>
                    <h3 class="empty-state-title">No Users Found</h3>
                </div>
            <% } %>
        </div>

        <!-- Provider Verification -->
        <div class="content-section" id="providers">
            <div class="content-section-header">
                <h2 class="content-section-title"><i class="fas fa-user-check"></i> Provider Verification</h2>
            </div>
            
            <% if (providers && providers.length > 0) { %>
                <div class="items-grid">
                    <% providers.slice(0, 12).forEach(provider => { %>
                    <div class="item-card">
                        <div class="item-card-header">
                            <h3 class="item-card-title">
                                <% if (provider.user) { %>
                                <i class="fas fa-user-circle"></i> <%= provider.user.name %>
                                <% } else { %>
                                Unknown Provider
                                <% } %>
                            </h3>
                            <span class="badge <%= provider.is_available ? 'badge-success' : 'badge-danger' %>">
                                <%= provider.is_available ? 'Available' : 'Unavailable' %>
                            </span>
                        </div>
                        <div class="item-card-meta">
                            <span class="item-card-meta-item">
                                <i class="fas fa-wrench"></i>
                                <%= provider.trade %>
                            </span>
                            <span class="item-card-meta-item">
                                <i class="fas fa-calendar-alt"></i>
                                <%= provider.experience_years %> years
                            </span>
                        </div>
                        <div class="item-card-price">KSh <%= provider.daily_rate.toLocaleString() %>/day</div>
                        <div class="item-card-actions">
                            <button class="btn-sm btn-primary">
                                <i class="fas fa-check"></i> Approve
                            </button>
                            <button class="btn-sm btn-secondary">
                                <i class="fas fa-eye"></i> View
                            </button>
                            <button class="btn-sm btn-danger">
                                <i class="fas fa-times"></i> Reject
                            </button>
                        </div>
                    </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <div class="empty-state-icon">
                        <i class="fas fa-user-check"></i>
                    </div>
                    <h3 class="empty-state-title">No Providers Found</h3>
                </div>
            <% } %>
        </div>

        <!-- Training Payments -->
        <div class="content-section" id="training">
            <div class="content-section-header">
                <h2 class="content-section-title"><i class="fas fa-graduation-cap"></i> Training Payments</h2>
                <p style="color:#6b7280;margin:4px 0 0">Training fee: KSh 1,500</p>
            </div>
            
            <% if (transactions && transactions.length > 0) { %>
                <div style="overflow-x:auto">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>User</th>
                                <th>Type</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Date</th>
                                <th style="text-align:center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% transactions.slice(0, 20).forEach(transaction => { %>
                            <tr>
                                <td><%= transaction.id %></td>
                                <td style="font-weight:600"><%= transaction.user ? transaction.user.name : 'N/A' %></td>
                                <td><%= transaction.transaction_type %></td>
                                <td style="font-weight:700;color:#f5a623">KSh <%= transaction.amount.toLocaleString() %></td>
                                <td>
                                    <span class="badge <%= transaction.status === 'completed' ? 'badge-success' : transaction.status === 'pending' ? 'badge-warning' : 'badge-danger' %>">
                                        <%= transaction.status %>
                                    </span>
                                </td>
                                <td style="font-size:12px;color:#6b7280"><%= new Date(transaction.created_at).toLocaleDateString() %></td>
                                <td style="text-align:center">
                                    <button class="btn-sm btn-primary">
                                        <i class="fas fa-check"></i> Verify
                                    </button>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <div class="empty-state-icon">
                        <i class="fas fa-graduation-cap"></i>
                    </div>
                    <h3 class="empty-state-title">No Training Payments Found</h3>
                </div>
            <% } %>
        </div>

        <!-- Products Management -->
        <div class="content-section" id="products">
            <div class="content-section-header">
                <h2 class="content-section-title"><i class="fas fa-boxes"></i> Products Management</h2>
            </div>
            
            <% if (allProducts && allProducts.length > 0) { %>
                <div class="items-grid">
                    <% allProducts.slice(0, 12).forEach(product => { %>
                    <div class="item-card">
                        <div class="item-card-header">
                            <h3 class="item-card-title"><%= product.title %></h3>
                            <span class="badge <%= product.is_active ? 'badge-success' : 'badge-danger' %>">
                                <%= product.is_active ? 'Active' : 'Inactive' %>
                            </span>
                        </div>
                        <p class="item-card-description"><%= product.description.substring(0, 80) %>...</p>
                        <div class="item-card-meta">
                            <% if (product.seller) { %>
                            <span class="item-card-meta-item">
                                <i class="fas fa-user"></i>
                                <%= product.seller.name %>
                            </span>
                            <% } %>
                            <span class="item-card-meta-item">
                                <i class="fas fa-warehouse"></i>
                                Stock: <%= product.stock_quantity %>
                            </span>
                        </div>
                        <div class="item-card-price">KSh <%= product.price.toLocaleString() %></div>
                        <div class="item-card-actions">
                            <button class="btn-sm btn-primary">
                                <i class="fas fa-eye"></i> View
                            </button>
                            <button class="btn-sm btn-secondary">
                                <i class="fas fa-edit"></i> Edit
                            </button>
                            <button class="btn-sm btn-danger">
                                <i class="fas fa-ban"></i> Remove
                            </button>
                        </div>
                    </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <div class="empty-state-icon">
                        <i class="fas fa-boxes"></i>
                    </div>
                    <h3 class="empty-state-title">No Products Found</h3>
                </div>
            <% } %>
        </div>
    </main>
</div>

<!-- Mobile Menu Toggle -->
<button class="mobile-menu-toggle" onclick="document.querySelector('.dashboard-sidebar').classList.toggle('open')">
    <i class="fas fa-bars"></i>
</button>

<script>
    // Close mobile menu when clicking outside
    document.addEventListener('click', function(event) {
        const sidebar = document.querySelector('.dashboard-sidebar');
        const toggle = document.querySelector('.mobile-menu-toggle');
        
        if (window.innerWidth <= 768 && 
            !sidebar.contains(event.target) && 
            !toggle.contains(event.target) && 
            sidebar.classList.contains('open')) {
            sidebar.classList.remove('open');
        }
    });

    // Smooth scroll to sections
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
            e.preventDefault();
            const target = document.querySelector(this.getAttribute('href'));
            if (target) {
                target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        });
    });
</script>

</body>
</html>

<!-- 1. Universal Delete Confirmation Modal -->
<div class="admin-modal-backdrop" id="deleteConfirmModal">
    <div class="admin-modal" style="max-width:440px;">
        <div class="admin-modal-header" style="border-bottom:none;padding-bottom:0;">
            <div style="width:40px;height:40px;border-radius:50%;background:#fee2e2;color:#ef4444;display:flex;align-items:center;justify-content:center;font-size:20px;margin-right:12px;">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
            <h3 class="admin-modal-title" style="flex:1;color:#b91c1c;">Confirm Deletion</h3>
            <button class="admin-modal-close" data-close-modal><i class="fas fa-times"></i></button>
        </div>
        <div class="admin-modal-body" style="padding-top:12px;">
            <p style="color:#4b5563;font-size:14px;line-height:1.5;margin-bottom:12px;">
                Are you sure you want to permanently delete:
            </p>
            <div id="deleteItemDetails" style="font-weight:700;color:#111827;background:#f9fafb;padding:12px;border-radius:8px;border:1px solid #e5e7eb;word-break:break-all;">
                Item details
            </div>
            <p style="color:#ef4444;font-size:12.5px;margin-top:12px;font-weight:600;">
                <i class="fas fa-info-circle"></i> This operation cannot be reversed.
            </p>
        </div>
        <div class="admin-modal-footer">
            <button type="button" class="btn-admin btn-admin-secondary" data-close-modal>Cancel</button>
            <button type="button" class="btn-admin btn-admin-danger" id="confirmDeleteBtn" onclick="executeDelete()">
                <i class="fas fa-trash"></i> Delete Record
            </button>
        </div>
    </div>
</div>

<!-- 2. View Training Payment Details Modal -->
<div class="admin-modal-backdrop" id="viewPaymentModal">
    <div class="admin-modal" style="max-width:520px;">
        <div class="admin-modal-header">
            <h3 class="admin-modal-title"><i class="fas fa-receipt" style="color:var(--admin-accent);"></i> Payment Transaction Details</h3>
            <button class="admin-modal-close" data-close-modal><i class="fas fa-times"></i></button>
        </div>
        <div class="admin-modal-body" id="viewPaymentDetailsBody">
            <!-- Dynamically populated -->
        </div>

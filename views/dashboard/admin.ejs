<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Admin Dashboard - Topline Construction' %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/admin-modern.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>

<div class="admin-page-container">
    <!-- Sidebar - Dedicated Page Navigation Links -->
    <aside class="admin-sidebar">
        <div class="admin-sidebar-header">
            <a href="/dashboard/admin" class="admin-sidebar-logo">
                <img src="/images/logo.png" alt="TopLine Logo" class="admin-sidebar-logo-img">
            </a>
        </div>
        <ul class="admin-nav-list">
            <li class="admin-nav-item">
                <a href="/dashboard/admin" class="admin-nav-link <%= activePage === 'overview' ? 'active' : '' %>">
                    <i class="fas fa-tachometer-alt"></i>
                    <span>Dashboard</span>
                </a>
            </li>
            <li class="admin-nav-item">
                <a href="/dashboard/admin/users" class="admin-nav-link <%= activePage === 'users' ? 'active' : '' %>">
                    <i class="fas fa-users"></i>
                    <span>Users</span>
                </a>
            </li>
            <li class="admin-nav-item">
                <a href="/dashboard/admin/providers" class="admin-nav-link <%= activePage === 'providers' ? 'active' : '' %>">
                    <i class="fas fa-user-check"></i>
                    <span>Providers</span>
                </a>
            </li>
            <li class="admin-nav-item">
                <a href="/dashboard/admin/training" class="admin-nav-link <%= activePage === 'training' ? 'active' : '' %>">
                    <i class="fas fa-graduation-cap"></i>
                    <span>Training Payments</span>
                </a>
            </li>
            <li class="admin-nav-item">
                <a href="/dashboard/admin/products" class="admin-nav-link <%= activePage === 'products' ? 'active' : '' %>">
                    <i class="fas fa-boxes"></i>
                    <span>Products</span>
                </a>
            </li>
            <li class="admin-nav-item">
                <a href="/dashboard/admin/jobs" class="admin-nav-link <%= activePage === 'jobs' ? 'active' : '' %>">
                    <i class="fas fa-briefcase"></i>
                    <span>Jobs</span>
                </a>
            </li>

            <li class="admin-nav-divider"></li>

            <li class="admin-nav-item">
                <a href="/" class="admin-nav-link" target="_blank">
                    <i class="fas fa-external-link-alt"></i>
                    <span>View Website</span>
                </a>
            </li>
            <li class="admin-nav-item">
                <a href="/auth/logout" class="admin-nav-link" style="color:#ef4444;">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>Logout</span>
                </a>
            </li>
        </ul>
    </aside>

    <!-- Main Content Area - Isolated Standalone Page Views (No Overscrolling!) -->
    <div class="admin-main-wrapper">
        <!-- Sticky Top Bar -->
        <header class="admin-topbar">
            <div style="display:flex;align-items:center;gap:12px;">
                <button class="mobile-menu-toggle" style="display:none;position:static;width:38px;height:38px;border-radius:8px;font-size:16px;" onclick="document.querySelector('.admin-sidebar').classList.toggle('open')">
                    <i class="fas fa-bars"></i>
                </button>
                <div class="admin-topbar-title">
                    <% if (activePage === 'overview') { %>
                        <i class="fas fa-chart-line" style="color:var(--admin-accent);"></i> Overview Dashboard
                    <% } else if (activePage === 'users') { %>
                        <i class="fas fa-users-cog" style="color:var(--admin-primary);"></i> User Management
                    <% } else if (activePage === 'providers') { %>
                        <i class="fas fa-user-check" style="color:var(--admin-primary);"></i> Provider Verification & Management
                    <% } else if (activePage === 'training') { %>
                        <i class="fas fa-graduation-cap" style="color:var(--admin-accent);"></i> Training Payments & Transactions
                    <% } else if (activePage === 'products') { %>
                        <i class="fas fa-cubes" style="color:var(--admin-primary);"></i> Products Inventory
                    <% } else if (activePage === 'jobs') { %>
                        <i class="fas fa-briefcase" style="color:var(--admin-primary);"></i> Construction Jobs
                    <% } %>
                </div>
            </div>

            <div class="admin-topbar-actions">
                <div class="admin-user-pill">
                    <i class="fas fa-user-shield"></i>
                    <span><%= user ? user.name : 'Administrator' %></span>
                </div>
            </div>
        </header>

        <!-- Page Body Content - ONLY Active Page is Loaded -->
        <main class="admin-page-body">

            <!-- ============================================================== -->
            <!-- 1. OVERVIEW DASHBOARD PAGE (Only shown on /dashboard/admin) -->
            <!-- ============================================================== -->
            <% if (activePage === 'overview') { %>
                <div class="page-header-box">
                    <div>
                        <h1>Dashboard Overview</h1>
                        <p>Welcome back! Monitor real-time platform metrics, training revenue, and recent operations.</p>
                    </div>
                    <div class="page-header-actions">
                        <a href="/dashboard/admin/training" class="btn-admin btn-admin-accent">
                            <i class="fas fa-money-check-alt"></i> Manage Training Payments
                        </a>
                        <a href="/dashboard/admin/users" class="btn-admin btn-admin-primary">
                            <i class="fas fa-user-plus"></i> Manage Users
                        </a>
                    </div>
                </div>

                <!-- Stats Grid -->
                <div class="admin-stats-grid">
                    <div class="admin-stat-card">
                        <div>
                            <div class="stat-info-title">Training Revenue</div>
                            <div class="stat-info-value" style="color:#f5a623;">KSh <%= Number(counts.trainingRevenue).toLocaleString() %></div>
                            <div class="stat-info-sub"><%= counts.trainingPayments %> recorded payments</div>
                        </div>
                        <div class="stat-icon-wrapper" style="background:#fef3e2;color:#f5a623;">
                            <i class="fas fa-graduation-cap"></i>
                        </div>
                    </div>

                    <div class="admin-stat-card">
                        <div>
                            <div class="stat-info-title">Total Users</div>
                            <div class="stat-info-value"><%= counts.users %></div>
                            <div class="stat-info-sub">Clients, Artisans & Suppliers</div>
                        </div>
                        <div class="stat-icon-wrapper" style="background:#e0f2fe;color:#0284c7;">
                            <i class="fas fa-users"></i>
                        </div>
                    </div>

                    <div class="admin-stat-card">
                        <div>
                            <div class="stat-info-title">Providers / Artisans</div>
                            <div class="stat-info-value"><%= counts.providers %></div>
                            <div class="stat-info-sub">Skilled trades registered</div>
                        </div>
                        <div class="stat-icon-wrapper" style="background:#dbeafe;color:#2563eb;">
                            <i class="fas fa-tools"></i>
                        </div>
                    </div>

                    <div class="admin-stat-card">
                        <div>
                            <div class="stat-info-title">Active Products</div>
                            <div class="stat-info-value"><%= counts.products %></div>
                            <div class="stat-info-sub">In marketplace catalog</div>
                        </div>
                        <div class="stat-icon-wrapper" style="background:#d1fae5;color:#059669;">
                            <i class="fas fa-boxes"></i>
                        </div>
                    </div>

                    <div class="admin-stat-card">
                        <div>
                            <div class="stat-info-title">Open Jobs</div>
                            <div class="stat-info-value"><%= counts.jobs %></div>
                            <div class="stat-info-sub">Live client requests</div>
                        </div>
                        <div class="stat-icon-wrapper" style="background:#ede9fe;color:#7c3aed;">
                            <i class="fas fa-briefcase"></i>
                        </div>
                    </div>
                </div>

                <!-- Recent Training Payments & Activities -->
                <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(460px, 1fr));gap:24px;">
                    <!-- Recent Transactions Card -->
                    <div class="admin-card">
                        <div class="admin-card-header">
                            <h2 class="admin-card-title">
                                <i class="fas fa-receipt" style="color:var(--admin-accent);"></i> Recent Transactions & Training
                            </h2>
                            <a href="/dashboard/admin/training" class="btn-admin btn-admin-secondary" style="font-size:12px;padding:6px 12px;">
                                View All <i class="fas fa-arrow-right"></i>
                            </a>
                        </div>
                        <div class="admin-table-responsive">
                            <table class="admin-modern-table">
                                <thead>
                                    <tr>
                                        <th>Ref / Receipt</th>
                                        <th>User</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (recentTransactions && recentTransactions.length > 0) { %>
                                        <% recentTransactions.forEach(tx => { %>
                                            <tr>
                                                <td style="font-weight:700;color:var(--admin-primary);font-size:12.5px;">
                                                    <%= tx.mpesa_receipt || '#' + tx.id %>
                                                </td>
                                                <td>
                                                    <div style="font-weight:600;"><%= tx.user ? tx.user.name : 'Guest' %></div>
                                                    <div style="font-size:11px;color:#9ca3af;"><%= tx.type %></div>
                                                </td>
                                                <td style="font-weight:700;color:#f5a623;">KSh <%= Number(tx.amount).toLocaleString() %></td>
                                                <td>
                                                    <span class="status-pill status-<%= tx.status %>"><%= tx.status %></span>
                                                </td>
                                                <td>
                                                    <div class="action-buttons-group">
                                                        <button class="btn-admin btn-admin-secondary btn-admin-icon" title="View Details" onclick="viewTrainingPayment(<%= tx.id %>)">
                                                            <i class="fas fa-eye"></i>
                                                        </button>
                                                        <button class="btn-admin btn-admin-danger btn-admin-icon" title="Delete Payment" onclick="confirmDelete('Payment', <%= tx.id %>, 'Transaction #<%= tx.id %> (<%= tx.mpesa_receipt || 'KSh ' + tx.amount %>)', '/dashboard/admin/training/<%= tx.id %>/delete', this.closest('tr'))">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="5" style="text-align:center;padding:30px;color:#9ca3af;">No recent transactions</td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Recent Users Card -->
                    <div class="admin-card">
                        <div class="admin-card-header">
                            <h2 class="admin-card-title">
                                <i class="fas fa-user-plus" style="color:var(--admin-primary);"></i> New Registrations
                            </h2>
                            <a href="/dashboard/admin/users" class="btn-admin btn-admin-secondary" style="font-size:12px;padding:6px 12px;">
                                View All <i class="fas fa-arrow-right"></i>
                            </a>
                        </div>
                        <div class="admin-table-responsive">
                            <table class="admin-modern-table">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Role</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (recentUsers && recentUsers.length > 0) { %>
                                        <% recentUsers.forEach(u => { %>
                                            <tr>
                                                <td style="font-weight:600;"><%= u.name %></td>
                                                <td style="color:#6b7280;font-size:12.5px;"><%= u.email %></td>
                                                <td>
                                                    <span class="role-badge role-<%= u.role %>"><%= u.role %></span>
                                                </td>
                                                <td>
                                                    <div class="action-buttons-group">
                                                        <button class="btn-admin btn-admin-secondary btn-admin-icon" title="Edit User" onclick="editUser(<%= u.id %>)">
                                                            <i class="fas fa-edit"></i>
                                                        </button>
                                                        <button class="btn-admin btn-admin-danger btn-admin-icon" title="Delete User" onclick="confirmDelete('User', <%= u.id %>, '<%= u.name %> (<%= u.email %>)', '/dashboard/admin/users/<%= u.id %>/delete', this.closest('tr'))">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="4" style="text-align:center;padding:30px;color:#9ca3af;">No users found</td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            <!-- ============================================================== -->
            <!-- 2. TRAINING PAYMENTS PAGE (Dedicated View with Full CRUD) -->
            <!-- ============================================================== -->
            <% } else if (activePage === 'training') { %>
                <div class="page-header-box">
                    <div>
                        <h1><i class="fas fa-graduation-cap" style="color:var(--admin-accent);"></i> Training Payments Management</h1>
                        <p>Complete control over training fee transactions. Create, view, update status, and delete records.</p>
                    </div>
                    <div class="page-header-actions">
                        <button class="btn-admin btn-admin-accent" data-open-modal="createTrainingModal">
                            <i class="fas fa-plus-circle"></i> Record Manual Payment
                        </button>
                    </div>
                </div>

                <!-- Training KPI Stats -->
                <div class="admin-stats-grid">
                    <div class="admin-stat-card">
                        <div>
                            <div class="stat-info-title">Total Revenue</div>
                            <div class="stat-info-value" style="color:#f5a623;">KSh <%= Number(stats.revenue).toLocaleString() %></div>
                            <div class="stat-info-sub">Completed training fees</div>
                        </div>
                        <div class="stat-icon-wrapper" style="background:#fef3e2;color:#f5a623;">
                            <i class="fas fa-coins"></i>
                        </div>
                    </div>
                    <div class="admin-stat-card">
                        <div>
                            <div class="stat-info-title">Total Records</div>
                            <div class="stat-info-value"><%= stats.total %></div>
                            <div class="stat-info-sub">All training transactions</div>
                        </div>
                        <div class="stat-icon-wrapper" style="background:#e0f2fe;color:#0284c7;">
                            <i class="fas fa-receipt"></i>
                        </div>
                    </div>
                    <div class="admin-stat-card">
                        <div>
                            <div class="stat-info-title">Completed</div>
                            <div class="stat-info-value" style="color:#10b981;"><%= stats.completed %></div>
                            <div class="stat-info-sub">Verified & confirmed</div>
                        </div>
                        <div class="stat-icon-wrapper" style="background:#d1fae5;color:#059669;">
                            <i class="fas fa-check-circle"></i>
                        </div>
                    </div>
                    <div class="admin-stat-card">
                        <div>
                            <div class="stat-info-title">Pending</div>
                            <div class="stat-info-value" style="color:#f59e0b;"><%= stats.pending %></div>
                            <div class="stat-info-sub">Awaiting verification</div>
                        </div>
                        <div class="stat-icon-wrapper" style="background:#fef3c7;color:#d97706;">
                            <i class="fas fa-clock"></i>
                        </div>
                    </div>
                    <div class="admin-stat-card">
                        <div>
                            <div class="stat-info-title">Failed / Refunded</div>
                            <div class="stat-info-value" style="color:#ef4444;"><%= stats.failed %></div>
                            <div class="stat-info-sub">Unsuccessful payments</div>
                        </div>
                        <div class="stat-icon-wrapper" style="background:#fee2e2;color:#dc2626;">
                            <i class="fas fa-times-circle"></i>
                        </div>
                    </div>
                </div>

                <!-- Training Payments Table Card -->
                <div class="admin-card">
                    <div class="admin-card-header">
                        <div class="admin-toolbar">
                            <input type="text" class="admin-search-input" placeholder="Live search payments by name, receipt, description...">
                            <select class="admin-select-filter" onchange="window.location.href='/dashboard/admin/training?status=' + this.value + '&type=<%= filter.type %>'">
                                <option value="all" <%= filter.status === 'all' ? 'selected' : '' %>>All Statuses</option>
                                <option value="completed" <%= filter.status === 'completed' ? 'selected' : '' %>>Completed</option>
                                <option value="pending" <%= filter.status === 'pending' ? 'selected' : '' %>>Pending</option>
                                <option value="failed" <%= filter.status === 'failed' ? 'selected' : '' %>>Failed / Refunded</option>
                            </select>
                            <select class="admin-select-filter" onchange="window.location.href='/dashboard/admin/training?type=' + this.value + '&status=<%= filter.status %>'">
                                <option value="training_fee" <%= filter.type === 'training_fee' ? 'selected' : '' %>>Training Fees Only</option>
                                <option value="all" <%= filter.type === 'all' ? 'selected' : '' %>>All System Transactions</option>
                            </select>
                        </div>
                        <div style="font-size:13px;color:#6b7280;font-weight:600;">
                            Showing <%= transactions.length %> payments
                        </div>
                    </div>

                    <div class="admin-table-responsive">
                        <table class="admin-modern-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>User / Customer</th>
                                    <th>Receipt / Ref</th>
                                    <th>Type</th>
                                    <th>Method</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                    <th style="text-align:right;">Actions (CRUD)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (transactions && transactions.length > 0) { %>
                                    <% transactions.forEach(tx => { %>
                                        <tr>
                                            <td style="font-weight:700;color:#9ca3af;">#<%= tx.id %></td>
                                            <td>
                                                <% 
                                                    let cName = tx.user ? tx.user.name : '';
                                                    let cEmail = tx.user ? tx.user.email : '';
                                                    let cPhone = tx.user ? tx.user.phone : '';

                                                    if (!cName || !cPhone || !cEmail) {
                                                        const desc = tx.description || '';
                                                        const matchName = desc.match(/Training Fee Payment -\s*([^|(\n]+)/i);
                                                        const matchPhone = desc.match(/Phone:\s*([^|\n-]+)/i);
                                                        const matchEmail = desc.match(/Email:\s*([^|\n-]+)/i);

                                                        if (!cName && matchName) cName = matchName[1].trim();
                                                        if (!cPhone && matchPhone) cPhone = matchPhone[1].trim();
                                                        if (!cEmail && matchEmail) cEmail = matchEmail[1].trim();
                                                    }
                                                %>
                                                <div style="font-weight:700;color:#111827;font-size:14px;"><%= cName || 'Training Client' %></div>
                                                <div style="font-size:12px;color:#0b3a6e;font-weight:600;margin-top:2px;">
                                                    <i class="fas fa-phone-alt" style="font-size:10px;margin-right:4px;"></i><%= cPhone || 'N/A' %>
                                                </div>
                                                <div style="font-size:12px;color:#6b7280;margin-top:1px;">
                                                    <i class="fas fa-envelope" style="font-size:10px;margin-right:4px;"></i><%= cEmail || 'N/A' %>
                                                </div>
                                            </td>
                                            <td>
                                                <code style="background:#f3f4f6;padding:3px 6px;border-radius:4px;font-size:12px;font-weight:700;color:#0b3a6e;">
                                                    <%= tx.mpesa_receipt || 'N/A' %>
                                                </code>
                                            </td>
                                            <td>
                                                <span class="role-badge role-buyer"><%= tx.type %></span>
                                            </td>
                                            <td style="text-transform:uppercase;font-size:12px;font-weight:600;color:#4b5563;">
                                                <%= tx.payment_method || 'mpesa' %>
                                            </td>
                                            <td style="font-weight:800;color:#f5a623;font-size:15px;">
                                                KSh <%= Number(tx.amount).toLocaleString() %>
                                            </td>
                                            <td>
                                                <span class="status-pill status-<%= tx.status %>"><%= tx.status %></span>
                                            </td>
                                            <td style="font-size:12px;color:#6b7280;white-space:nowrap;">
                                                <%= new Date(tx.created_at).toLocaleDateString() %><br>
                                                <span style="font-size:11px;color:#9ca3af;"><%= new Date(tx.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></span>
                                            </td>
                                            <td style="text-align:right;">
                                                <div class="action-buttons-group" style="justify-content:flex-end;">
                                                    <button class="btn-admin btn-admin-secondary btn-admin-icon" title="View Full Payment" onclick="viewTrainingPayment(<%= tx.id %>)">
                                                        <i class="fas fa-eye"></i> View
                                                    </button>
                                                    <button class="btn-admin btn-admin-primary btn-admin-icon" title="Edit Status/Receipt" onclick="editTrainingPayment(<%= tx.id %>)">
                                                        <i class="fas fa-edit"></i> Edit
                                                    </button>
                                                    <button class="btn-admin btn-admin-danger btn-admin-icon" title="Delete Payment" onclick="confirmDelete('Training Payment', <%= tx.id %>, 'Payment #<%= tx.id %> (<%= tx.mpesa_receipt || 'KSh ' + tx.amount %>)', '/dashboard/admin/training/<%= tx.id %>/delete', this.closest('tr'))">
                                                        <i class="fas fa-trash"></i> Delete
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="9">
                                            <div class="empty-state">
                                                <div class="empty-state-icon"><i class="fas fa-receipt"></i></div>
                                                <h3 class="empty-state-title">No Training Payments Found</h3>
                                                <p class="empty-state-description">No records match the current filters. Click "Record Manual Payment" to add one.</p>
                                            </div>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            <!-- ============================================================== -->
            <!-- 3. USERS MANAGEMENT PAGE (Dedicated View with Full CRUD) -->
            <!-- ============================================================== -->
            <% } else if (activePage === 'users') { %>
                <div class="page-header-box">
                    <div>
                        <h1><i class="fas fa-users-cog" style="color:var(--admin-primary);"></i> User Management</h1>
                        <p>Manage all system users, assign roles (clients, artisans, suppliers, admins), and monitor activity.</p>
                    </div>
                    <div class="page-header-actions">
                        <button class="btn-admin btn-admin-primary" data-open-modal="createUserModal">
                            <i class="fas fa-user-plus"></i> Add New User
                        </button>
                    </div>
                </div>

                <!-- User Stats -->
                <div class="admin-stats-grid">
                    <div class="admin-stat-card">
                        <div>
                            <div class="stat-info-title">Total Users</div>
                            <div class="stat-info-value"><%= stats.total %></div>
                        </div>
                        <div class="stat-icon-wrapper" style="background:#e0f2fe;color:#0284c7;"><i class="fas fa-users"></i></div>
                    </div>
                    <div class="admin-stat-card">
                        <div>
                            <div class="stat-info-title">Buyers / Clients</div>
                            <div class="stat-info-value"><%= stats.buyers %></div>
                        </div>
                        <div class="stat-icon-wrapper" style="background:#f3f4f6;color:#374151;"><i class="fas fa-user"></i></div>
                    </div>
                    <div class="admin-stat-card">
                        <div>
                            <div class="stat-info-title">Artisans / Providers</div>
                            <div class="stat-info-value"><%= stats.artisans %></div>
                        </div>
                        <div class="stat-icon-wrapper" style="background:#dbeafe;color:#2563eb;"><i class="fas fa-tools"></i></div>
                    </div>
                    <div class="admin-stat-card">
                        <div>
                            <div class="stat-info-title">Suppliers</div>
                            <div class="stat-info-value"><%= stats.sellers %></div>
                        </div>
                        <div class="stat-icon-wrapper" style="background:#fef3c7;color:#d97706;"><i class="fas fa-store"></i></div>
                    </div>
                    <div class="admin-stat-card">
                        <div>
                            <div class="stat-info-title">Administrators</div>

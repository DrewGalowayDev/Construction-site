<%- include('partials/header') %>
<%- include('partials/nav') %>

<header class="hero">
    <div class="w">
        <div class="tag">KENYA • CONSTRUCTION • CLEANING • REPAIRS</div>
        <h1>Find &amp; book trusted pros. <span>Get it done.</span></h1>
        <p>Vetted service providers, simple job posting and a construction materials marketplace — one platform, paid safely via M-PESA.</p>
        <div class="hero-btns">
            <a class="btn" href="/providers">Get a provider</a> 
            <a class="btn o" href="/jobs">Post a job</a>
        </div>
    </div>
</header>

<section>
    <div class="w">
        <h2>How it works</h2>
        <p class="sub">Three steps, no phone-tag.</p>
        <div class="grid">
            <div class="c">
                <div class="ic" style="background:#0b3a6e;color:#fff"><i class="fas fa-edit"></i></div>
                <b>1. Tell us what you need</b>
                <p class="sub" style="margin:4px 0 0">Request a provider or post a job in under a minute.</p>
            </div>
            <div class="c">
                <div class="ic" style="background:#0b3a6e;color:#fff"><i class="fas fa-handshake"></i></div>
                <b>2. We match you</b>
                <p class="sub" style="margin:4px 0 0">Vetted pros are matched to your job, location and budget.</p>
            </div>
            <div class="c">
                <div class="ic" style="background:#0b3a6e;color:#fff"><i class="fas fa-check-circle"></i></div>
                <b>3. Pay safely</b>
                <p class="sub" style="margin:4px 0 0">M-PESA escrow releases payment only when the job is done.</p>
            </div>
        </div>
    </div>
</section>

<section>
    <div class="w">
        <div class="train">
            <div class="tag">UPCOMING TRAINING</div>
            <h2 style="color:#fff;margin-top:6px">Construction Materials Dropshipping Class</h2>
            <p style="color:#cfdcee;margin:8px 0 14px">Learn to sell construction materials on TopLine without holding stock. Limited seats.</p>
            <div class="price">KSh 1,500</div>
            <div style="height:14px"></div>
            <a class="btn" href="/training">Reserve your seat</a>
        </div>
    </div>
</section>

<section class="alt">
    <div class="w">
        <h2>What would you like to do?</h2>
        <p class="sub">Pick a path.</p>
        <div class="grid">
            <a class="c" href="/providers">
                <div class="ic" style="background:#f5a623;color:#07284f"><i class="fas fa-tools"></i></div>
                <b>Get or join as a provider</b>
                <p class="sub" style="margin:4px 0 0">Need a pro, or want to offer your skills?</p>
            </a>
            <a class="c" href="/jobs">
                <div class="ic" style="background:#f5a623;color:#07284f"><i class="fas fa-briefcase"></i></div>
                <b>Post a job</b>
                <p class="sub" style="margin:4px 0 0">Describe it and get quotes from providers.</p>
            </a>
            <a class="c" href="/materials">
                <div class="ic" style="background:#f5a623;color:#07284f"><i class="fas fa-cubes"></i></div>
                <b>List construction materials</b>
                <p class="sub" style="margin:4px 0 0">Suppliers: add your products to our marketplace.</p>
            </a>
        </div>
    </div>
</section>

<% if (featuredProducts && featuredProducts.length > 0) { %>
<section>
    <div class="w">
        <h2>Featured Construction Materials</h2>
        <p class="sub">Latest products from verified suppliers</p>
        <div class="grid">
            <% featuredProducts.forEach(product => { %>
            <div class="c">
                <b><i class="fas fa-box" style="color:var(--gold);margin-right:8px"></i><%= product.title %></b>
                <p class="sub" style="margin:4px 0 0"><%= product.description || 'Quality construction material' %></p>
                <p style="margin-top:8px;font-weight:700;color:var(--gold)">KSh <%= product.price ? product.price.toLocaleString() : 'Contact' %></p>
                <% if (product.seller) { %>
                <p class="sub" style="margin:2px 0 0;font-size:12px"><i class="fas fa-user"></i> <%= product.seller.name %></p>
                <% } %>
                <% if (product.location_county) { %>
                <p class="sub" style="margin:2px 0 0;font-size:12px"><i class="fas fa-map-marker-alt"></i> <%= product.location_county %></p>
                <% } %>
            </div>
            <% }) %>
        </div>
        <div style="text-align:center;margin-top:24px">
            <a class="btn" href="/materials">View all materials</a>
        </div>
    </div>
</section>
<% } %>

<% if (recentJobs && recentJobs.length > 0) { %>
<section class="alt">
    <div class="w">
        <h2>Recent Job Postings</h2>
        <p class="sub">Open jobs from clients</p>
        <div class="grid">
            <% recentJobs.forEach(job => { %>
            <div class="c">
                <b><i class="fas fa-clipboard-list" style="color:var(--gold);margin-right:8px"></i><%= job.title %></b>
                <p class="sub" style="margin:4px 0 0"><%= job.description ? job.description.substring(0, 100) : 'Job details' %>...</p>
                <% if (job.budget_estimate) { %>
                <p style="margin-top:8px;font-weight:700;color:var(--gold)"><i class="fas fa-money-bill-wave"></i> KSh <%= job.budget_estimate.toLocaleString() %></p>
                <% } %>
                <p class="sub" style="margin:2px 0 0;font-size:12px"><i class="fas fa-map-marker-alt"></i> <%= job.location_town || job.location_county || 'Not specified' %></p>
            </div>
            <% }) %>
        </div>
        <div style="text-align:center;margin-top:24px">
            <a class="btn n" href="/jobs">View all jobs</a>
        </div>
    </div>
</section>
<% } %>

<%- include('partials/footer') %>

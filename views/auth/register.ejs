<%- include('../partials/header') %>

<style>
.auth-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #0b3a6e 0%, #07284f 100%);
    padding: 20px;
}
.auth-card {
    background: var(--bg);
    border-radius: 20px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    max-width: 550px;
    width: 100%;
    padding: 40px;
}
.auth-card .logo {
    width: 120px;
    height: auto;
    margin: 0 auto 20px;
    display: block;
}
.auth-card h2 {
    color: var(--navy);
    margin-bottom: 8px;
    text-align: center;
}
.auth-card .subtitle {
    color: var(--mu);
    text-align: center;
    margin-bottom: 30px;
    font-size: 14px;
}
.form-group {
    margin-bottom: 18px;
}
.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
}
.form-group label {
    display: block;
    font-weight: 600;
    font-size: 13px;
    margin-bottom: 6px;
    color: var(--tx);
}
.form-group input, .form-group select {
    width: 100%;
    padding: 12px 14px;
    border: 2px solid var(--ln);
    border-radius: 10px;
    font: inherit;
    background: var(--card);
    color: var(--tx);
    transition: all 0.3s;
}
.form-group input:focus, .form-group select:focus {
    outline: none;
    border-color: var(--gold);
    background: var(--bg);
}
.role-selector {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-bottom: 20px;
}
.role-option {
    position: relative;
}
.role-option input[type="radio"] {
    position: absolute;
    opacity: 0;
}
.role-option label {
    display: block;
    padding: 12px 8px;
    border: 2px solid var(--ln);
    border-radius: 8px;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s;
    background: var(--card);
    font-size: 12px;
    font-weight: 600;
}
.role-option input[type="radio"]:checked + label {
    border-color: var(--gold);
    background: var(--gold);
    color: #07284f;
}
.alert {
    padding: 12px 16px;
    border-radius: 8px;
    margin-bottom: 20px;
    font-size: 14px;
}
.alert-danger {
    background: #fee;
    color: #c33;
    border: 1px solid #fcc;
}
.btn-auth {
    width: 100%;
    padding: 16px;
    background: var(--gold);
    color: #07284f;
    font-weight: 700;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    font-size: 16px;
    transition: all 0.3s;
    margin-top: 10px;
}
.btn-auth:hover {
    background: #d49020;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(245, 166, 35, 0.4);
}
.auth-footer {
    text-align: center;
    margin-top: 25px;
    padding-top: 20px;
    border-top: 1px solid var(--ln);
}
.auth-footer a {
    color: var(--gold);
    font-weight: 600;
    text-decoration: none;
}
.auth-footer a:hover {
    text-decoration: underline;
}
@media (max-width: 600px) {
    .form-row {
        grid-template-columns: 1fr;
    }
    .role-selector {
        grid-template-columns: 1fr;
    }
}
</style>

<div class="auth-page">
    <div class="auth-card">
        <img src="/images/logo.png" alt="TopLine" class="logo">
        <h2>Create Account</h2>
        <p class="subtitle">Join Kenya's fastest-growing construction marketplace</p>

        <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-circle"></i> <%= error %>
        </div>
        <% } %>

        <form action="/auth/register" method="POST">
            <div class="form-group">
                <label><i class="fas fa-user-tag"></i> I am joining as:</label>
                <div class="role-selector">
                    <div class="role-option">
                        <input type="radio" id="buyer" name="role" value="buyer" checked>
                        <label for="buyer"><i class="fas fa-user"></i> Client</label>
                    </div>
                    <div class="role-option">
                        <input type="radio" id="seller" name="role" value="seller">
                        <label for="seller"><i class="fas fa-box"></i> Supplier</label>
                    </div>
                    <div class="role-option">
                        <input type="radio" id="artisan" name="role" value="artisan">
                        <label for="artisan"><i class="fas fa-tools"></i> Provider</label>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label for="name"><i class="fas fa-user"></i> Full Name / Business Name</label>
                <input type="text" id="name" name="name" placeholder="John Doe" required>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="email"><i class="fas fa-envelope"></i> Email</label>
                    <input type="email" id="email" name="email" placeholder="your@email.com" required>
                </div>
                <div class="form-group">
                    <label for="phone"><i class="fas fa-phone"></i> Phone</label>
                    <input type="tel" id="phone" name="phone" placeholder="0712345678" required>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="county"><i class="fas fa-map-marker-alt"></i> County</label>
                    <select id="county" name="county" required>
                        <% counties.forEach(c => { %>
                        <option value="<%= c %>" <%= c === 'Nairobi' ? 'selected' : '' %>><%= c %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="form-group">
                    <label for="town"><i class="fas fa-map-pin"></i> Town</label>
                    <input type="text" id="town" name="town" placeholder="Nairobi" value="Nairobi" required>
                </div>
            </div>

            <div class="form-group">
                <label for="password"><i class="fas fa-lock"></i> Password</label>
                <input type="password" id="password" name="password" placeholder="Minimum 6 characters" minlength="6" required>
            </div>

            <button type="submit" class="btn-auth">
                <i class="fas fa-user-plus"></i> Create Account
            </button>
        </form>

        <div class="auth-footer">
            <p style="color:var(--mu);font-size:14px">
                Already have an account? 
                <a href="/auth/login">Sign In</a>
            </p>
            <p style="color:var(--mu);font-size:12px;margin-top:10px">
                <a href="/" style="color:var(--mu)">
                    <i class="fas fa-arrow-left"></i> Back to Home
                </a>
            </p>
        </div>
    </div>
</div>

</body>
</html>

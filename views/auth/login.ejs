<%- include('../partials/header') %>

<style>
.auth-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #0b3a6e 0%, #07284f 100%);
    padding: 20px;
}
.auth-card {
    background: var(--bg);
    border-radius: 20px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    max-width: 450px;
    width: 100%;
    padding: 40px;
}
.auth-card .logo {
    width: 120px;
    height: auto;
    margin: 0 auto 20px;
    display: block;
}
.auth-card h2 {
    color: var(--navy);
    margin-bottom: 8px;
    text-align: center;
}
.auth-card .subtitle {
    color: var(--mu);
    text-align: center;
    margin-bottom: 30px;
    font-size: 14px;
}
.form-group {
    margin-bottom: 20px;
}
.form-group label {
    display: block;
    font-weight: 600;
    font-size: 14px;
    margin-bottom: 8px;
    color: var(--tx);
}
.form-group input {
    width: 100%;
    padding: 14px 16px;
    border: 2px solid var(--ln);
    border-radius: 10px;
    font: inherit;
    background: var(--card);
    color: var(--tx);
    transition: all 0.3s;
}
.form-group input:focus {
    outline: none;
    border-color: var(--gold);
    background: var(--bg);
}
.alert {
    padding: 12px 16px;
    border-radius: 8px;
    margin-bottom: 20px;
    font-size: 14px;
}
.alert-danger {
    background: #fee;
    color: #c33;
    border: 1px solid #fcc;
}
.btn-auth {
    width: 100%;
    padding: 16px;
    background: var(--gold);
    color: #07284f;
    font-weight: 700;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    font-size: 16px;
    transition: all 0.3s;
}
.btn-auth:hover {
    background: #d49020;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(245, 166, 35, 0.4);
}
.auth-footer {
    text-align: center;
    margin-top: 30px;
    padding-top: 20px;
    border-top: 1px solid var(--ln);
}
.auth-footer a {
    color: var(--gold);
    font-weight: 600;
    text-decoration: none;
}
.auth-footer a:hover {
    text-decoration: underline;
}
</style>

<div class="auth-page">
    <div class="auth-card">
        <img src="/images/logo.png" alt="TopLine" class="logo">
        <h2>Welcome Back</h2>
        <p class="subtitle">Sign in to access your dashboard</p>

        <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-circle"></i> <%= error %>
        </div>
        <% } %>

        <form action="/auth/login" method="POST">
            <div class="form-group">
                <label for="email">
                    <i class="fas fa-user"></i> Username or Email
                </label>
                <input type="text" id="email" name="email" placeholder="Enter username or email" required>
            </div>

            <div class="form-group">
                <label for="password">
                    <i class="fas fa-lock"></i> Password
                </label>
                <input type="password" id="password" name="password" placeholder="Enter your password" required>
            </div>

            <button type="submit" class="btn-auth">
                <i class="fas fa-sign-in-alt"></i> Sign In
            </button>
        </form>

        <div class="auth-footer">
            <p style="color:var(--mu);font-size:14px">
                Don't have an account? 
                <a href="/auth/register">Create Account</a>
            </p>
            <p style="color:var(--mu);font-size:12px;margin-top:10px">
                <a href="/" style="color:var(--mu)">
                    <i class="fas fa-arrow-left"></i> Back to Home
                </a>
            </p>
        </div>
    </div>
</div>

</body>
</html>

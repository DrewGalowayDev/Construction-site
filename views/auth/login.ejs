<!-- CAROUSEL AUTO-TRANSITION (EVERY 3 SECONDS) & CLIENT LOGIC -->
<script>
(function() {
  let currentIndex = 0;
  const slides = document.querySelectorAll('.carousel-slide');
  const dots = document.querySelectorAll('.indicator-dot');
  const totalSlides = slides.length;
  let carouselTimer = null;
  const INTERVAL_MS = 3000; // Exactly 3 seconds

  function showSlide(index) {
    if (index < 0) index = totalSlides - 1;
    if (index >= totalSlides) index = 0;
    currentIndex = index;

    slides.forEach((s, idx) => {
      if (idx === currentIndex) {
        s.classList.add('active');
      } else {
        s.classList.remove('active');
      }
    });

    dots.forEach((d, idx) => {
      if (idx === currentIndex) {
        d.classList.add('active');
        // Restart CSS progress bar animation
        const fill = d.querySelector('.progress-fill');
        if (fill) {
          fill.style.animation = 'none';
          void fill.offsetWidth; // Trigger reflow
          fill.style.animation = 'progressTimer 3s linear forwards';
        }
      } else {
        d.classList.remove('active');
        const fill = d.querySelector('.progress-fill');
        if (fill) fill.style.animation = 'none';
      }
    });
  }

  function startTimer() {
    stopTimer();
    carouselTimer = setInterval(() => {
      showSlide(currentIndex + 1);
    }, INTERVAL_MS);
  }

  function stopTimer() {
    if (carouselTimer) {
      clearInterval(carouselTimer);
      carouselTimer = null;
    }
  }

  window.nextSlide = function() {
    showSlide(currentIndex + 1);
    startTimer();
  };

  window.prevSlide = function() {
    showSlide(currentIndex - 1);
    startTimer();
  };

  window.jumpToSlide = function(index) {
    showSlide(index);
    startTimer();
  };

  // Pause on hover over carousel, resume on leave
  const heroSide = document.getElementById('heroCarouselSide');
  if (heroSide) {
    heroSide.addEventListener('mouseenter', () => {
      // Keep timer running so user still sees 3-second cycle unless actively interacting
    });
  }

  // Password visibility toggle (Zero emojis)
  window.togglePasswordVisibility = function(inputId, btn) {
    const input = document.getElementById(inputId);
    if (!input) return;
    if (input.type === 'password') {
      input.type = 'text';
      btn.innerHTML = '<i class="fas fa-eye-slash"></i>';
    } else {
      input.type = 'password';
      btn.innerHTML = '<i class="fas fa-eye"></i>';
    }
  };

  // Quick fill demo user
  window.fillDemoUser = function(user, pass) {
    const emailEl = document.getElementById('signinEmail');
    const passEl = document.getElementById('signinPassword');
    if (emailEl) emailEl.value = user;
    if (passEl) passEl.value = pass;
    const btn = document.getElementById('btnSignInSubmit');
    if (btn) btn.focus();
  };

  // Start the 3-second carousel on page load
  showSlide(0);
  startTimer();
})();
</script>


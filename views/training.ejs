<%- include('partials/header') %>
<%- include('partials/nav') %>

<header class="hero s">
    <div class="w">
        <div class="tag">UPCOMING TRAINING</div>
        <h1>Construction Materials <span>Dropshipping Class</span></h1>
        <p>Learn to sell construction materials on TopLine without holding stock.</p>
    </div>
</header>

<section>
    <div class="w">
        <% if (hasPaid) { %>
        <!-- Already Paid Message -->
        <div style="background:#d1fae5;border:2px solid#10b981;border-radius:12px;padding:32px;text-align:center;margin-bottom:32px">
            <div style="font-size:64px;color:#10b981;margin-bottom:16px">
                <i class="fas fa-check-circle"></i>
            </div>
            <h2 style="color:#065f46;margin:0 0 8px">Payment Confirmed!</h2>
            <p style="color:#047857;font-size:16px;margin:0">You have successfully paid for the training. We will contact you with the date and venue details.</p>
            <% if (userPayment) { %>
            <p style="color:#059669;font-size:14px;margin:16px 0 0">Payment Reference: <%= userPayment.mpesa_receipt %></p>
            <% } %>
        </div>
        <% } %>

        <div class="train" style="margin-bottom:28px">
            <ul>
                <li>How dropshipping works with our supplier back end</li>
                <li>Product knowledge: cement, steel, roofing, tiles, paint</li>
                <li>Pricing, margins and finding contractors &amp; homeowners</li>
                <li>Orders, M-PESA payouts and customer service</li>
            </ul>
            <div class="price" style="margin-top:14px">
                KSh <%= trainingFee.toLocaleString() %> 
                <small style="font-size:15px;color:#cfdcee">one-off</small>
            </div>
            <p style="color:#b6c7dc;font-size:14px">Date and venue to be announced. Limited seats.</p>
        </div>
        
        <% if (!hasPaid) { %>
        <form id="trainingForm" class="fm">
            <label>Full name *</label>
            <input name="name" id="name" type="text" placeholder="Enter your full name" required>
            
            <div class="two">
                <div>
                    <label>M-PESA / Phone *</label>
                    <input name="phone" id="phone" type="tel" placeholder="0712345678" required>
                </div>
                <div>
                    <label>Town / county</label>
                    <input name="location" id="location" type="text" placeholder="Nairobi">
                </div>
            </div>

            <label>Email (optional)</label>
            <input name="email" id="email" type="email" placeholder="your@email.com">
            
            <div id="alert-message" style="display:none;padding:16px;border-radius:8px;margin:16px 0;font-size:14px"></div>
            
            <div style="height:16px"></div>
            <button type="submit" class="btn n" id="submitBtn" style="width:100%">
                <i class="fas fa-credit-card"></i> Pay KSh <%= trainingFee.toLocaleString() %> via Paystack
            </button>
        </form>
        <% } else { %>
        <div style="text-align:center;padding:24px;background:var(--card);border-radius:12px">
            <p style="color:var(--sub);margin:0">You have already registered and paid for this training.</p>
            <a href="/dashboard/provider" class="btn" style="margin-top:16px;display:inline-block">Go to Dashboard</a>
        </div>
        <% } %>
    </div>
</section>

<%- include('partials/footer') %>

<% if (!hasPaid) { %>
<script src="https://js.paystack.co/v1/inline.js"></script>
<script>
    const trainingForm = document.getElementById('trainingForm');
    const submitBtn = document.getElementById('submitBtn');
    const alertMessage = document.getElementById('alert-message');

    function showAlert(message, type = 'error') {
        alertMessage.textContent = message;
        alertMessage.style.display = 'block';
        alertMessage.style.background = type === 'success' ? '#d1fae5' : '#fee2e2';
        alertMessage.style.color = type === 'success' ? '#065f46' : '#991b1b';
        alertMessage.style.border = type === 'success' ? '1px solid #10b981' : '1px solid #ef4444';
        
        // Auto hide after 5 seconds
        setTimeout(() => {
            alertMessage.style.display = 'none';
        }, 5000);
    }

    trainingForm.addEventListener('submit', async function(e) {
        e.preventDefault();

        <% if (!user) { %>
        // Require login
        showAlert('Please login or register first to pay for training', 'error');
        setTimeout(() => {
            window.location.href = '/auth/login?redirect=/training';
        }, 2000);
        return;
        <% } %>
        
        const name = document.getElementById('name').value;
        const phone = document.getElementById('phone').value;
        const location = document.getElementById('location').value;
        const email = document.getElementById('email').value;

        if (!name || !phone) {
            showAlert('Please fill in all required fields');
            return;
        }

        // Disable submit button
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';

        try {
            // Initialize payment
            const response = await fetch('/training/payment/initialize', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    name: name,
                    phone: phone,
                    location: location,
                    email: email
                })
            });

            const data = await response.json();

            if (!data.success) {
                showAlert(data.message || 'Failed to initialize payment');
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="fas fa-credit-card"></i> Pay KSh <%= trainingFee.toLocaleString() %> via Paystack';
                return;
            }

            // Redirect to Paystack
            if (data.authorization_url) {
                window.location.href = data.authorization_url;
            } else {
                showAlert('Payment initialization failed');
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="fas fa-credit-card"></i> Pay KSh <%= trainingFee.toLocaleString() %> via Paystack';
            }

        } catch (err) {
            console.error('Payment error:', err);
            showAlert('Network error. Please try again.');
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="fas fa-credit-card"></i> Pay KSh <%= trainingFee.toLocaleString() %> via Paystack';
        }
    });
</script>
<% } %>


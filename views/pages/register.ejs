<!-- Register Page Start -->
<div class="container-fluid py-5 my-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card card-custom p-4 p-md-5 bg-white">
                    <div class="text-center mb-4">
                        <i class="fa fa-hard-hat text-primary fa-3x mb-2"></i>
                        <h3 class="fw-bold text-dark">Create Your Account</h3>
                        <p class="text-muted small">Join Kenya's fastest-growing construction marketplace</p>
                    </div>

                    <form action="/auth/register" method="POST">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label small fw-bold">I am joining as:</label>
                                <div class="d-flex gap-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="role" id="role_buyer" value="buyer" checked>
                                        <label class="form-check-label" for="role_buyer">Buyer / Client</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="role" id="role_seller" value="seller">
                                        <label class="form-check-label" for="role_seller">Material / Plant Supplier</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="role" id="role_artisan" value="artisan">
                                        <label class="form-check-label" for="role_artisan">Fundi / Artisan</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-floating">
                                    <input type="text" name="name" class="form-control" id="reg_name" placeholder="Full Name or Business Name" required>
                                    <label for="reg_name">Full Name / Business Name</label>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-floating">
                                    <input type="tel" name="phone" class="form-control" id="reg_phone" placeholder="0712345678" required>
                                    <label for="reg_phone">Phone / WhatsApp</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-floating">
                                    <input type="email" name="email" class="form-control" id="reg_email" placeholder="name@example.com" required>
                                    <label for="reg_email">Email address</label>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-floating">
                                    <select name="county" class="form-select" id="reg_county" required>
                                        <% counties.forEach(c => { %>
                                            <option value="<%= c %>" <%= c === 'Nairobi' ? 'selected' : '' %>><%= c %></option>
                                        <% }) %>
                                    </select>
                                    <label for="reg_county">Base County</label>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-floating">
                                    <input type="text" name="town" class="form-control" id="reg_town" placeholder="Westlands" value="Nairobi" required>
                                    <label for="reg_town">Town / Subcounty</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-floating">
                                    <input type="password" name="password" class="form-control" id="reg_password" placeholder="Password" minlength="6" required>
                                    <label for="reg_password">Password (min 6 chars)</label>
                                </div>
                            </div>
                            <div class="col-12 mt-4">
                                <button type="submit" class="btn btn-primary w-100 py-3 text-white fw-bold">Complete Registration</button>
                            </div>
                        </div>
                    </form>

                    <div class="text-center pt-3 border-top mt-4">
                        <span class="text-muted small">Already have an account? </span>
                        <a href="/auth/login" class="fw-bold text-primary">Login Here</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

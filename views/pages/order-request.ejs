<!-- Page Header Start -->
<div class="container-fluid page-header py-5 mb-5 wow fadeIn" data-wow-delay="0.1s">
    <div class="container text-center py-5">
        <h1 class="display-4 text-white animated slideInDown mb-3">Order / Quote Request</h1>
        <nav aria-label="breadcrumb animated slideInDown">
            <ol class="breadcrumb justify-content-center mb-0">
                <li class="breadcrumb-item"><a class="text-white" href="/">Home</a></li>
                <li class="breadcrumb-item"><a class="text-white" href="/materials">Materials</a></li>
                <li class="breadcrumb-item text-primary active" aria-current="page">Request</li>
            </ol>
        </nav>
    </div>
</div>
<!-- Page Header End -->

<div class="container-xxl py-5">
    <div class="container">
        <div class="row g-5">
            <!-- Item Overview -->
            <div class="col-lg-5">
                <div class="card card-custom p-4 bg-light">
                    <img src="<%= product.image_url %>" class="img-fluid rounded mb-3" style="max-height: 260px; object-fit: cover;" alt="<%= product.title %>">
                    <span class="badge bg-primary text-uppercase mb-2 align-self-start"><%= product.is_rental ? 'Equipment Hire' : 'Building Material' %></span>
                    <h4 class="fw-bold text-dark"><%= product.title %></h4>
                    <p class="text-muted"><%= product.description %></p>
                    <div class="product-price mb-3">
                        Ksh <%= Number(product.price).toLocaleString() %> <span>/ <%= product.unit %></span>
                    </div>
                    <div class="border-top pt-3 small text-muted">
                        <p class="mb-1"><i class="fa fa-map-marker-alt text-primary me-2"></i>Location: <strong><%= product.location_county %></strong></p>
                        <p class="mb-1"><i class="fa fa-truck text-primary me-2"></i>Delivery: <strong>Site Delivery Available Across Kenya</strong></p>
                    </div>
                </div>
            </div>

            <!-- Request Form -->
            <div class="col-lg-7">
                <div class="card card-custom p-4 p-md-5 bg-white">
                    <h3 class="fw-bold mb-2">Request Quote / Place Order</h3>
                    <p class="text-muted mb-4">Submit your delivery details. We will confirm stock and provide an all-inclusive quote with transport.</p>
                    
                    <form action="/orders/submit" method="POST">
                        <input type="hidden" name="product_id" value="<%= product.id %>">
                        <input type="hidden" name="unit_price" value="<%= product.price %>">

                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label class="form-label fw-bold small">Quantity (<%= product.unit %>s)</label>
                                <input type="number" name="quantity" id="order_qty" class="form-control" value="1" min="1" required>
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label fw-bold small">Estimated Total (Ksh)</label>
                                <input type="text" id="total_display" class="form-control bg-light" value="Ksh <%= Number(product.price).toLocaleString() %>" readonly>
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label fw-bold small">Full Name</label>
                                <input type="text" name="full_name" class="form-control" value="<%= user ? user.name : '' %>" required>
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label fw-bold small">Phone / WhatsApp</label>
                                <input type="tel" name="contact_phone" class="form-control" placeholder="0712345678" value="<%= user ? user.phone : '' %>" required>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold small">Site Delivery Address / Landmarks</label>
                                <input type="text" name="delivery_address" class="form-control" placeholder="e.g. Ruiru Mugutha, near Deliverance Church" required>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold small">Special Instructions / Offloading Notes</label>
                                <textarea name="notes" rows="3" class="form-control" placeholder="Specify if site has crane access, delivery date preference, offloading crew needed..."></textarea>
                            </div>
                            <div class="col-12 mt-4">
                                <button type="submit" class="btn btn-primary w-100 py-3 text-white fw-bold">Submit Order / Quote Request</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const qtyInput = document.getElementById('order_qty');
        const totalDisplay = document.getElementById('total_display');
        const unitPrice = <%= Number(product.price) %>;

        qtyInput.addEventListener('input', () => {
            const qty = Math.max(1, parseInt(qtyInput.value) || 1);
            const total = qty * unitPrice;
            totalDisplay.value = 'Ksh ' + total.toLocaleString();
        });
    });
</script>

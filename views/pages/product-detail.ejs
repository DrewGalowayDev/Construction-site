<!-- Page Header Start -->
<div class="container-fluid page-header py-5 mb-5 wow fadeIn" data-wow-delay="0.1s">
    <div class="container text-center py-5">
        <h1 class="display-4 text-white animated slideInDown mb-3"><%= product.title %></h1>
        <nav aria-label="breadcrumb animated slideInDown">
            <ol class="breadcrumb justify-content-center mb-0">
                <li class="breadcrumb-item"><a class="text-white" href="/">Home</a></li>
                <li class="breadcrumb-item">
                    <a class="text-white" href="<%= product.is_rental ? '/rentals' : '/materials' %>">
                        <%= product.is_rental ? 'Equipment Hire' : 'Building Materials' %>
                    </a>
                </li>
                <li class="breadcrumb-item text-primary active" aria-current="page"><%= product.title %></li>
            </ol>
        </nav>
    </div>
</div>
<!-- Page Header End -->

<div class="container-xxl py-4">
    <div class="container">
        <div class="row g-5">
            <!-- Left Column: Image and Full Specs -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm overflow-hidden mb-4 bg-white">
                    <div class="position-relative" style="height: 380px;">
                        <img src="<%= product.image_url %>" class="w-100 h-100" style="object-fit: cover; transition: opacity 0.3s ease;" alt="<%= product.title %>" id="mainProductImage">
                        <span class="badge <%= product.is_rental ? 'bg-primary' : 'bg-dark' %> position-absolute top-0 start-0 m-3 fs-6 px-3 py-2">
                            <i class="<%= product.is_rental ? 'fa fa-truck-pickup' : 'fa fa-cubes' %> me-1"></i>
                            <%= product.is_rental ? 'Equipment For Hire' : 'Building Material' %>
                        </span>
                        <span class="badge bg-secondary position-absolute top-0 end-0 m-3 fs-6 px-3 py-2">
                            <i class="fa fa-map-marker-alt me-1"></i><%= product.location_county %>
                        </span>
                        <% if (product.images && product.images.length > 1) { %>
                            <span class="badge bg-dark bg-opacity-75 position-absolute bottom-0 end-0 m-3 px-3 py-2">
                                <i class="fa fa-images me-1"></i><%= product.images.length %> Photos
                            </span>
                        <% } %>
                    </div>

                    <% if (product.images && product.images.length > 1) { %>
                        <!-- Image Gallery Thumbnails -->
                        <div class="p-2 bg-light border-top">
                            <div class="d-flex gap-2 overflow-auto pb-1" style="scrollbar-width: thin;">
                                <% product.images.forEach((imgUrl, idx) => { %>
                                    <img src="<%= imgUrl %>" 
                                         class="gallery-thumb rounded border <%= idx === 0 ? 'border-primary border-2' : 'border-secondary' %>" 
                                         style="width: 70px; height: 55px; object-fit: cover; cursor: pointer; flex-shrink: 0; transition: all 0.2s ease;"
                                         alt="Photo <%= idx + 1 %>"
                                         onclick="switchMainImage(this, '<%= imgUrl %>')">
                                <% }) %>
                            </div>
                        </div>
                    <% } %>
                </div>

                <!-- Product Specifications Card -->
                <div class="card border-0 shadow-sm p-4 bg-white mb-4">
                    <h4 class="fw-bold text-dark mb-3">Item Description & Specifications</h4>
                    <p class="text-muted leading-relaxed mb-4" style="font-size: 1.05rem;">
                        <%= product.description %>
                    </p>

                    <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">Technical Overview</h5>
                    <div class="row g-3 text-secondary mb-4">
                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded">
                                <small class="text-muted d-block">Industry Category</small>
                                <strong class="text-dark"><%= product.category ? product.category.name : 'General' %></strong>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded">
                                <small class="text-muted d-block">Measurement / Pricing Unit</small>
                                <strong class="text-dark"><%= product.unit %></strong>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded">
                                <small class="text-muted d-block">Available Inventory / Fleet Count</small>
                                <strong class="text-dark"><%= product.stock_quantity %> units available</strong>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded">
                                <small class="text-muted d-block">Location Base</small>
                                <strong class="text-dark"><%= product.location_county %></strong>
                            </div>
                        </div>
                    </div>

                    <!-- Delivery & Haulage terms -->
                    <div class="alert alert-light border d-flex align-items-start gap-3 mb-0">
                        <i class="fa fa-truck-loading fa-2x text-primary mt-1"></i>
                        <div>
                            <strong class="text-dark d-block">Site Delivery & Mobilization</strong>
                            <small class="text-muted">
                                Direct site delivery available across <%= product.location_county %> and neighboring counties. Minimum order quantities and offloading terms apply for bulk aggregates and tippers.
                            </small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Pricing, Booking & Vendor Contact -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm p-4 bg-white sticky-top" style="top: 100px;">
                    <div class="small text-primary fw-bold text-uppercase mb-1">
                        <%= product.category ? product.category.name : 'Construction Supply' %>
                    </div>
                    <h3 class="fw-bold text-dark mb-3"><%= product.title %></h3>

                    <div class="p-3 bg-light rounded mb-4">
                        <small class="text-muted d-block">
                            <%= product.is_rental ? 'Daily Hire Rate' : 'Material Price' %>
                        </small>
                        <div class="display-6 fw-bold text-primary mb-1">
                            Ksh <%= Number(product.price).toLocaleString() %>
                            <span class="fs-6 text-muted fw-normal">/ <%= product.unit %></span>
                        </div>
                        <span class="badge bg-success"><i class="fa fa-check-circle me-1"></i>In Stock & Available</span>
                    </div>

                    <!-- Direct Order Action -->
                    <div class="d-grid gap-2 mb-4">
                        <!-- Buy Now Button (Direct Purchase via Paystack) -->
                        <button type="button" class="btn py-3 fw-bold shadow-sm text-white" style="background: linear-gradient(135deg, #0ba4db, #0883af);" data-bs-toggle="modal" data-bs-target="#buyNowModal">
                            <i class="fa fa-bolt me-2"></i>Buy Now & Pay via Paystack
                        </button>

                        <a href="/orders/request/<%= product.id %>" class="btn btn-outline-primary py-3 fw-bold">
                            <i class="fa fa-clipboard-list me-2"></i>
                            <%= product.is_rental ? 'Book Equipment Hire (Quote)' : 'Request Quote Only' %>
                        </a>
                        <% if (product.contactUnlocked) { %>
                            <% 
                                const sellerPhone = product.seller ? product.seller.phone.replace(/[^0-9]/g, '') : '254711000000';
                                const waClean = sellerPhone.startsWith('0') ? '254' + sellerPhone.slice(1) : sellerPhone;
                                const waMsg = encodeURIComponent('Hi ' + (product.seller ? product.seller.name : 'Vendor') + ', I am inquiring about "' + product.title + '" (Ksh ' + Number(product.price).toLocaleString() + '/' + product.unit + ') listed on TopLineHub.');
                            %>
                            <a href="https://wa.me/<%= waClean %>?text=<%= waMsg %>" target="_blank" class="btn btn-whatsapp py-3 fw-bold">
                                <i class="fab fa-whatsapp me-2"></i>Inquire on WhatsApp
                            </a>
                            <% if (product.seller && product.seller.phone) { %>
                                <a href="tel:<%= product.seller.phone %>" class="btn btn-outline-dark py-2">
                                    <i class="fa fa-phone me-2"></i>Call Vendor (<%= product.seller.phone %>)
                                </a>
                            <% } %>
                        <% } else { %>
                            <div class="card bg-light border p-3 text-center">
                                <div class="text-muted small mb-2">
                                    <i class="fa fa-lock text-warning me-1"></i>Direct vendor phone & WhatsApp are protected.
                                </div>
                                <form action="/unlock/material/<%= product.id %>" method="POST">
                                    <button type="submit" class="btn btn-warning py-2 w-100 fw-bold text-dark shadow-sm">
                                        <i class="fa fa-unlock-alt me-1"></i>Unlock WhatsApp & Direct Phone (Ksh <%= product.unlockPrice %>)
                                    </button>
                                </form>
                            </div>
                        <% } %>

                        <!-- Escrow Trust Badge -->
                        <div class="d-flex align-items-center gap-2 p-2 bg-light rounded border mt-1">
                            <i class="fa fa-shield-alt text-success"></i>
                            <small class="text-muted">
                                <strong class="text-dark">Buyer Protection:</strong> Payments are held securely until you confirm delivery & satisfaction.
                            </small>
                        </div>
                    </div>

                    <!-- Vendor Profile Card -->
                    <div class="border-top pt-4">
                        <h6 class="fw-bold text-dark mb-3"><i class="fa fa-store text-primary me-2"></i>Listed By Vendor</h6>
                        <div class="d-flex align-items-center gap-3">
                            <img src="<%= product.seller && product.seller.avatar ? product.seller.avatar : '/img/team-1.jpg' %>" class="rounded-circle border" style="width: 55px; height: 55px; object-fit: cover;" alt="Seller">
                            <div>
                                <h6 class="fw-bold text-dark mb-0"><%= product.seller ? product.seller.name : 'Verified Hardware Supplier' %></h6>
                                <small class="text-muted d-block">
                                    <i class="fa fa-map-marker-alt me-1 text-primary"></i><%= product.seller ? product.seller.town + ', ' + product.seller.county : product.location_county %>
                                </small>
                                <% if (product.seller && product.seller.is_verified) { %>
                                    <span class="badge bg-success mt-1"><i class="fa fa-shield-alt me-1"></i>Verified Supplier</span>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Related Products Section -->
        <% if (relatedProducts && relatedProducts.length > 0) { %>
            <div class="mt-5 pt-4 border-top">
                <div class="border-start border-5 border-primary ps-4 mb-4">
                    <h6 class="text-body text-uppercase mb-1">Related Inventory</h6>
                    <h3 class="mb-0">More in <%= product.category ? product.category.name : 'This Category' %></h3>
                </div>
                <div class="row g-4">
                    <% relatedProducts.forEach(rel => { %>
                        <div class="col-md-6 col-lg-4">
                            <div class="card card-custom h-100 bg-white border-0 shadow-sm">
                                <div style="height: 180px; overflow: hidden;" class="position-relative">
                                    <img src="<%= rel.image_url %>" class="w-100 h-100" style="object-fit: cover;" alt="<%= rel.title %>">
                                    <span class="badge bg-dark position-absolute top-0 end-0 m-2"><%= rel.location_county %></span>
                                </div>
                                <div class="card-body p-3 d-flex flex-column">
                                    <h6 class="card-title fw-bold text-dark mb-2"><%= rel.title %></h6>
                                    <div class="product-price mb-3 mt-auto">
                                        Ksh <%= Number(rel.price).toLocaleString() %> <span class="small text-muted">/ <%= rel.unit %></span>
                                    </div>
                                    <a href="/materials/<%= rel.id %>" class="btn btn-outline-primary btn-sm fw-bold">
                                        View Details & Rates
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        <% } %>
    </div>
</div>

<!-- Buy Now Modal -->
<div class="modal fade" id="buyNowModal" tabindex="-1" aria-labelledby="buyNowModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header text-white border-0" style="background: linear-gradient(135deg, #0ba4db, #0883af);">
                <h5 class="modal-title fw-bold" id="buyNowModalLabel">
                    <i class="fa fa-bolt me-2"></i>Buy Now — Direct Purchase
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Product Summary Row -->
                <div class="d-flex align-items-center gap-3 p-3 bg-light rounded mb-4">
                    <img src="<%= product.image_url %>" class="rounded" style="width: 70px; height: 70px; object-fit: cover;" alt="<%= product.title %>">
                    <div class="flex-grow-1">
                        <h6 class="fw-bold text-dark mb-0"><%= product.title %></h6>
                        <small class="text-muted"><%= product.category ? product.category.name : 'Construction Supply' %></small>
                    </div>
                    <div class="text-end">
                        <div class="fw-bold text-primary">Ksh <%= Number(product.price).toLocaleString() %></div>
                        <small class="text-muted">per <%= product.unit %></small>
                    </div>
                </div>

                <form action="/orders/quick-purchase" method="POST" id="buyNowForm">
                    <input type="hidden" name="product_id" value="<%= product.id %>">

                    <div class="row g-3">
                        <div class="col-sm-4">
                            <label class="form-label fw-bold small">Quantity (<%= product.unit %>s)</label>
                            <input type="number" name="quantity" id="buyNowQty" class="form-control form-control-lg" value="1" min="1" required>
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label fw-bold small">Subtotal</label>
                            <input type="text" id="buyNowSubtotal" class="form-control form-control-lg bg-light" value="Ksh <%= Number(product.price).toLocaleString() %>" readonly>
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label fw-bold small">Total (incl. 16% VAT)</label>
                            <input type="text" id="buyNowTotal" class="form-control form-control-lg bg-light fw-bold text-primary" value="Ksh <%= (Number(product.price) * 1.16).toLocaleString(undefined, {minimumFractionDigits: 2}) %>" readonly>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label fw-bold small">Full Name *</label>
                            <input type="text" name="full_name" class="form-control" value="<%= typeof user !== 'undefined' && user ? user.name : '' %>" placeholder="Your full name" required>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label fw-bold small">Phone / WhatsApp *</label>
                            <input type="tel" name="contact_phone" class="form-control" placeholder="0712345678" value="<%= typeof user !== 'undefined' && user ? user.phone : '' %>" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small">Site Delivery Address *</label>
                            <input type="text" name="delivery_address" class="form-control" placeholder="e.g. Ruiru Mugutha, near Deliverance Church" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small">Notes (optional)</label>
                            <textarea name="notes" rows="2" class="form-control" placeholder="Special delivery instructions, offloading crew needed..."></textarea>
                        </div>
                    </div>

                    <!-- Escrow Info -->
                    <div class="alert alert-info d-flex align-items-start gap-2 mt-3 mb-0 py-2">
                        <i class="fa fa-shield-alt text-info mt-1"></i>
                        <small>
                            <strong>Buyer Protection:</strong> Your payment will be securely held in escrow via Paystack. The supplier will deliver your order, and funds are only released to them once you confirm you are satisfied with the products.
                        </small>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light border-0 p-3">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" form="buyNowForm" class="btn text-white fw-bold px-4 py-2 shadow-sm" style="background: linear-gradient(135deg, #0ba4db, #0883af);">
                    <i class="fa fa-lock me-2"></i>Pay <span id="buyNowPayAmount">Ksh <%= (Number(product.price) * 1.16).toLocaleString(undefined, {minimumFractionDigits: 2}) %></span> via Paystack
                </button>
            </div>
        </div>
    </div>
</div>

<script>
function switchMainImage(thumbEl, imageUrl) {
    const mainImg = document.getElementById('mainProductImage');
    if (!mainImg) return;
    
    mainImg.style.opacity = '0.3';
    setTimeout(() => {
        mainImg.src = imageUrl;
        mainImg.style.opacity = '1';
    }, 150);

    document.querySelectorAll('.gallery-thumb').forEach(el => {
        el.classList.remove('border-primary', 'border-2');
        el.classList.add('border-secondary');
    });
    thumbEl.classList.remove('border-secondary');
    thumbEl.classList.add('border-primary', 'border-2');
}

// Buy Now modal dynamic total calculation
document.addEventListener('DOMContentLoaded', () => {
    const qtyInput = document.getElementById('buyNowQty');
    const subtotalEl = document.getElementById('buyNowSubtotal');
    const totalEl = document.getElementById('buyNowTotal');
    const payAmountEl = document.getElementById('buyNowPayAmount');
    const unitPrice = <%= Number(product.price) %>;

    if (qtyInput) {
        qtyInput.addEventListener('input', () => {
            const qty = Math.max(1, parseInt(qtyInput.value) || 1);
            const subtotal = qty * unitPrice;
            const vat = subtotal * 0.16;
            const total = subtotal + vat;

            subtotalEl.value = 'Ksh ' + subtotal.toLocaleString();
            totalEl.value = 'Ksh ' + total.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            payAmountEl.textContent = 'Ksh ' + total.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        });
    }
});
</script>


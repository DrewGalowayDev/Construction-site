<!-- Top Workspace Status Bar -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
            <span>Workstation & Marketplace</span>
            <span class="badge bg-warning text-dark text-uppercase" style="font-size: 0.7rem;"><%= currentUser.role %> portal</span>
        </h4>
        <div class="text-muted small">
            <i class="fa fa-user me-1 text-primary"></i>Logged in as <strong><%= currentUser.name %></strong> &bull;
            <i class="fa fa-map-marker-alt ms-2 me-1 text-primary"></i><%= currentUser.town %>, <%= currentUser.county %>
        </div>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <button type="button" class="btn btn-sm btn-warning text-dark fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#mpesaTopupModal">
            <i class="fa fa-bolt me-1"></i>Top Up Credits
        </button>
        <a href="/jobs/post" class="btn btn-sm btn-outline-dark fw-bold">
            <i class="fa fa-plus me-1"></i>Post Job
        </a>
        <a href="/materials/post" class="btn btn-sm btn-primary text-white fw-bold">
            <i class="fa fa-plus me-1"></i>List Material/Plant
        </a>
    </div>
</div>

<!-- ========================================== -->
<!-- TAB 1: OVERVIEW & REAL-TIME SUMMARY -->
<!-- ========================================== -->
<% if (activeTab === 'overview') { %>
    <!-- Stat Widgets -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="stat-widget">
                <div class="stat-icon-wrap bg-warning bg-opacity-10 text-warning">
                    <i class="fa fa-wallet"></i>
                </div>
                <div>
                    <div class="text-muted small fw-bold text-uppercase">Wallet Balance</div>
                    <div class="fs-4 fw-bold text-dark">KES <%= userWallet ? Number(userWallet.balance).toLocaleString() : '100' %></div>
                    <a href="/dashboard?tab=wallet" class="small text-warning fw-bold text-decoration-none">View ledger &rarr;</a>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="stat-widget">
                <div class="stat-icon-wrap bg-primary bg-opacity-10 text-primary">
                    <i class="fa fa-hard-hat"></i>
                </div>
                <div>
                    <div class="text-muted small fw-bold text-uppercase">My Active Bids</div>
                    <div class="fs-4 fw-bold text-dark"><%= myApplications.length %></div>
                    <a href="/dashboard?tab=artisan" class="small text-primary fw-bold text-decoration-none">Manage proposals &rarr;</a>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="stat-widget">
                <div class="stat-icon-wrap bg-success bg-opacity-10 text-success">
                    <i class="fa fa-boxes"></i>
                </div>
                <div>
                    <div class="text-muted small fw-bold text-uppercase">Listed Inventory</div>
                    <div class="fs-4 fw-bold text-dark"><%= myProducts.length %></div>
                    <a href="/dashboard?tab=supplier" class="small text-success fw-bold text-decoration-none">View materials & fleet &rarr;</a>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="stat-widget">
                <div class="stat-icon-wrap bg-info bg-opacity-10 text-info">
                    <i class="fa fa-clipboard-check"></i>
                </div>
                <div>
                    <div class="text-muted small fw-bold text-uppercase">Hire Enquiries & Orders</div>
                    <div class="fs-4 fw-bold text-dark"><%= incomingInquiries.length + myOrders.length %></div>
                    <a href="/dashboard?tab=orders" class="small text-info fw-bold text-decoration-none">Review client requests &rarr;</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Monetization Banner -->
    <div class="dash-card border-warning border-opacity-25 bg-warning bg-opacity-10 p-3 mb-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="fs-2 text-warning"><i class="fa fa-shield-alt"></i></div>
                <div>
                    <h6 class="fw-bold text-dark mb-1">Direct Contact Gating & Platform Monetization Active</h6>
                    <p class="small text-muted mb-0">Clients' phone numbers and WhatsApp buttons are automatically protected. Job seekers and equipment renters pay platform charges via wallet to reveal contact details and close deals.</p>
                </div>
            </div>
            <div>
                <a href="/dashboard?tab=wallet" class="btn btn-sm btn-warning text-dark fw-bold">
                    <i class="fa fa-coins me-1"></i>Wallet & Pricing Details
                </a>
            </div>
        </div>
    </div>

    <!-- Overview Content Split -->
    <div class="row g-4">
        <!-- Left: Recent Submitted Bids -->
        <div class="col-lg-6">
            <div class="dash-card h-100">
                <div class="dash-card-header">
                    <h6 class="dash-card-title"><i class="fa fa-paper-plane text-primary"></i>My Recent Bids & Proposals</h6>
                    <a href="/dashboard?tab=artisan" class="btn btn-sm btn-outline-primary">View All (<%= myApplications.length %>)</a>
                </div>
                <div class="dash-card-body p-0">
                    <% if (myApplications.length === 0) { %>
                        <div class="p-4 text-center text-muted">
                            <i class="fa fa-hammer fa-2x mb-2 text-secondary opacity-50"></i>
                            <p class="small mb-2">You haven't submitted any bids on construction jobs yet.</p>
                            <a href="/dashboard?tab=marketplace" class="btn btn-sm btn-primary text-white">Find Construction Jobs</a>
                        </div>
                    <% } else { %>
                        <div class="list-group list-group-flush">
                            <% myApplications.slice(0, 4).forEach(app => { %>
                                <div class="list-group-item p-3">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <h6 class="fw-bold text-dark mb-0"><%= app.job ? app.job.title : 'Project' %></h6>
                                        <span class="badge <%= app.status === 'accepted' ? 'bg-success' : (app.status === 'shortlisted' ? 'bg-warning text-dark' : 'bg-secondary') %> text-uppercase" style="font-size: 0.65rem;">
                                            <%= app.status %>
                                        </span>
                                    </div>
                                    <div class="text-muted small mb-2">
                                        Your Bid: <strong class="text-primary">Ksh <%= Number(app.bid_amount).toLocaleString() %></strong> &bull;
                                        Location: <%= app.job ? app.job.location_county : 'Kenya' %>
                                    </div>
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div>
                                            <% if (app.contactUnlocked) { %>
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                    <i class="fa fa-unlock me-1"></i>Client: <%= app.clientPhone %>
                                                </span>
                                            <% } else { %>
                                                <span class="badge bg-light text-muted border">
                                                    <i class="fa fa-lock text-warning me-1"></i>Client: <%= app.maskedClientPhone %>
                                                </span>
                                            <% } %>
                                        </div>
                                        <div>
                                            <% if (app.contactUnlocked) { %>
                                                <a href="<%= app.waUrl %>" target="_blank" class="btn btn-whatsapp btn-sm py-1 px-2" style="font-size: 0.75rem;">
                                                    <i class="fab fa-whatsapp me-1"></i>WhatsApp
                                                </a>
                                            <% } else { %>
                                                <form action="/unlock/job/<%= app.job_id %>" method="POST" class="d-inline">
                                                    <button type="submit" class="btn btn-unlock-gold btn-sm py-1 px-2" style="font-size: 0.75rem;">
                                                        <i class="fa fa-lock me-1"></i>Unlock (Ksh <%= app.unlockPrice %>)
                                                    </button>
                                                </form>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Right: Recent Incoming Enquiries & Hire Requests -->
        <div class="col-lg-6">
            <div class="dash-card h-100">
                <div class="dash-card-header">
                    <h6 class="dash-card-title"><i class="fa fa-truck-loading text-success"></i>Incoming Material Orders & Plant Hire</h6>
                    <a href="/dashboard?tab=orders" class="btn btn-sm btn-outline-success">View All (<%= incomingInquiries.length %>)</a>
                </div>
                <div class="dash-card-body p-0">
                    <% if (incomingInquiries.length === 0) { %>
                        <div class="p-4 text-center text-muted">
                            <i class="fa fa-dolly fa-2x mb-2 text-secondary opacity-50"></i>
                            <p class="small mb-2">No incoming material orders or equipment hire inquiries yet.</p>
                            <a href="/materials/post" class="btn btn-sm btn-success text-white">List Materials or Equipment</a>
                        </div>
                    <% } else { %>
                        <div class="list-group list-group-flush">
                            <% incomingInquiries.slice(0, 4).forEach(order => { %>
                                <div class="list-group-item p-3">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <h6 class="fw-bold text-dark mb-0"><%= order.product ? order.product.title : 'Supply Order' %></h6>
                                        <span class="badge bg-secondary text-uppercase" style="font-size: 0.65rem;"><%= order.status %></span>
                                    </div>
                                    <div class="text-muted small mb-2">
                                        <%= order.quantity %> units &bull; <strong class="text-success">Ksh <%= Number(order.total_price).toLocaleString() %></strong> &bull;
                                        Buyer: <%= order.buyer ? order.buyer.name : 'Client' %>
                                    </div>
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div>
                                            <% if (order.contactUnlocked) { %>
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                    <i class="fa fa-phone me-1"></i><%= order.buyerPhone %>
                                                </span>
                                            <% } else { %>
                                                <span class="badge bg-light text-muted border">
                                                    <i class="fa fa-lock text-warning me-1"></i><%= order.maskedBuyerPhone %>
                                                </span>
                                            <% } %>
                                        </div>
                                        <div>
                                            <% if (order.contactUnlocked) { %>
                                                <a href="<%= order.waOrderUrl %>" target="_blank" class="btn btn-whatsapp btn-sm py-1 px-2" style="font-size: 0.75rem;">
                                                    <i class="fab fa-whatsapp me-1"></i>WhatsApp Client
                                                </a>
                                            <% } else { %>
                                                <form action="/unlock/order/<%= order.id %>" method="POST" class="d-inline">
                                                    <button type="submit" class="btn btn-unlock-gold btn-sm py-1 px-2" style="font-size: 0.75rem;" title="Pay platform commission charge to reveal client phone & WhatsApp">
                                                        <i class="fa fa-coins me-1"></i>Unlock Contact (Ksh <%= order.unlockPrice %>)
                                                    </button>
                                                </form>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
<% } %>

<!-- ========================================== -->
<!-- TAB 2: JOB SEEKER & ARTISAN BIDS -->
<!-- ========================================== -->
<% if (activeTab === 'artisan') { %>
    <div class="dash-card">
        <div class="dash-card-header">
            <div>
                <h5 class="dash-card-title"><i class="fa fa-hard-hat text-primary"></i>My Submitted Proposals & Site Bids</h5>
                <small class="text-muted">Track your job applications. WhatsApp and client phone numbers are revealed when unlocked.</small>
            </div>
            <a href="/dashboard?tab=marketplace" class="btn btn-sm btn-primary text-white fw-bold">
                <i class="fa fa-search me-1"></i>Find More Jobs
            </a>
        </div>
        <div class="dash-card-body">
            <% if (myApplications.length === 0) { %>
                <div class="text-center py-5">
                    <i class="fa fa-briefcase fa-3x text-muted mb-3 opacity-50"></i>
                    <h5 class="text-dark">No Submitted Proposals</h5>
                    <p class="text-muted small">You haven't applied for any site jobs yet. Browse open projects and submit your pitches.</p>
                    <a href="/dashboard?tab=marketplace" class="btn btn-primary text-white">Browse Project Board</a>
                </div>
            <% } else { %>
                <div class="row g-3">
                    <% myApplications.forEach(app => { %>
                        <div class="col-12">
                            <div class="border rounded p-3 bg-white">
                                <div class="row align-items-center">
                                    <div class="col-lg-7">
                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <span class="badge <%= app.status === 'accepted' ? 'bg-success' : (app.status === 'shortlisted' ? 'bg-warning text-dark' : (app.status === 'rejected' ? 'bg-danger' : 'bg-secondary')) %> text-uppercase">
                                                Status: <%= app.status %>
                                            </span>
                                            <span class="badge bg-light text-dark border">
                                                Trade: <%= app.job ? app.job.trade_required : 'Artisan' %>
                                            </span>
                                            <span class="text-muted small">
                                                <i class="fa fa-calendar-alt me-1"></i><%= new Date(app.created_at).toLocaleDateString() %>
                                            </span>
                                        </div>
                                        <h5 class="fw-bold text-dark mb-1"><%= app.job ? app.job.title : 'Project' %></h5>
                                        <p class="text-muted small mb-2">"<%= app.pitch_message %>"</p>
                                        <div class="small text-secondary">
                                            <i class="fa fa-map-marker-alt text-primary me-1"></i><%= app.job ? app.job.location_town + ', ' + app.job.location_county : 'Kenya' %> &bull;
                                            Client: <strong><%= app.job && app.job.client ? app.job.client.name : 'Site Client' %></strong>
                                        </div>
                                    </div>

                                    <div class="col-lg-5 text-lg-end mt-3 mt-lg-0 border-start ps-lg-4">
                                        <div class="mb-2">
                                            <span class="text-muted small">Your Quoted Bid:</span>
                                            <div class="fs-4 fw-bold text-primary">Ksh <%= Number(app.bid_amount).toLocaleString() %></div>
                                            <small class="text-muted">Client Budget: Ksh <%= app.job ? Number(app.job.budget_estimate).toLocaleString() : '0' %></small>
                                        </div>

                                        <!-- CONTACT & WHATSAPP GATING -->
                                        <div class="d-flex flex-wrap gap-2 justify-content-lg-end align-items-center mt-3">
                                            <% if (app.contactUnlocked) { %>
                                                <div class="alert alert-success d-flex align-items-center gap-2 py-1 px-3 mb-0 w-100 justify-content-lg-end">
                                                    <i class="fa fa-check-circle text-success"></i>
                                                    <span class="fw-bold small text-dark"><%= app.clientPhone %></span>
                                                    <a href="tel:<%= app.clientPhone %>" class="btn btn-sm btn-dark py-1 px-2" title="Call Client">
                                                        <i class="fa fa-phone me-1"></i>Call
                                                    </a>
                                                    <!-- WhatsApp button ONLY appears when unlocked! -->
                                                    <a href="<%= app.waUrl %>" target="_blank" class="btn btn-sm btn-whatsapp py-1 px-2" title="Chat on WhatsApp">
                                                        <i class="fab fa-whatsapp me-1"></i>WhatsApp
                                                    </a>
                                                </div>
                                            <% } else { %>
                                                <div class="d-flex flex-column align-items-lg-end gap-1 w-100">
                                                    <div class="text-muted small">
                                                        <i class="fa fa-lock text-warning me-1"></i>Client Phone: <strong><%= app.maskedClientPhone %></strong>
                                                    </div>
                                                    <form action="/unlock/job/<%= app.job_id %>" method="POST">
                                                        <button type="submit" class="btn btn-unlock-gold btn-sm fw-bold shadow-sm" title="Pay Ksh <%= app.unlockPrice %> to reveal client phone & WhatsApp">
                                                            <i class="fa fa-unlock-alt me-1"></i>Unlock WhatsApp & Phone (Ksh <%= app.unlockPrice %>)
                                                        </button>
                                                    </form>
                                                </div>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>
    </div>
<% } %>

<!-- ========================================== -->
<!-- TAB 3: CLIENT PROJECTS & RECEIVED BIDS -->
<!-- ========================================== -->
<% if (activeTab === 'client') { %>
    <div class="dash-card">
        <div class="dash-card-header">
            <div>
                <h5 class="dash-card-title"><i class="fa fa-briefcase text-primary"></i>My Posted Construction Projects</h5>
                <small class="text-muted">Review proposals submitted by fundis, shortlist candidates, and call or WhatsApp selected artisans.</small>
            </div>
            <a href="/jobs/post" class="btn btn-sm btn-primary text-white fw-bold">
                <i class="fa fa-plus me-1"></i>Post New Project
            </a>
        </div>
        <div class="dash-card-body">
            <% if (postedJobs.length === 0) { %>
                <div class="text-center py-5">
                    <i class="fa fa-clipboard fa-3x text-muted mb-3 opacity-50"></i>
                    <h5 class="text-dark">No Projects Posted Yet</h5>
                    <p class="text-muted small">Post your construction job or renovation task and receive proposals from vetted fundis.</p>
                    <a href="/jobs/post" class="btn btn-primary text-white">Post Construction Project</a>
                </div>
            <% } else { %>
                <div class="accordion" id="postedJobsAccordion">
                    <% postedJobs.forEach((job, idx) => { %>
                        <div class="accordion-item mb-3 border rounded shadow-sm overflow-hidden">
                            <h2 class="accordion-header" id="headingJob<%= job.id %>">
                                <button class="accordion-button <%= idx !== 0 ? 'collapsed' : '' %> bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapseJob<%= job.id %>">
                                    <div class="d-flex flex-wrap align-items-center justify-content-between w-100 pe-3 gap-2">
                                        <div>
                                            <span class="badge bg-primary text-uppercase me-2"><%= job.trade_required %></span>
                                            <strong class="text-dark"><%= job.title %></strong>
                                            <span class="badge <%= job.status === 'open' ? 'bg-success' : 'bg-secondary' %> ms-2 text-uppercase"><%= job.status %></span>
                                        </div>
                                        <div class="text-muted small">
                                            Budget: <strong class="text-primary">Ksh <%= Number(job.budget_estimate).toLocaleString() %></strong> &bull;
                                            Proposals: <span class="badge bg-secondary"><%= job.applications ? job.applications.length : 0 %></span>
                                        </div>
                                    </div>
                                </button>
                            </h2>
                            <div id="collapseJob<%= job.id %>" class="accordion-collapse collapse <%= idx === 0 ? 'show' : '' %>" data-bs-parent="#postedJobsAccordion">
                                <div class="accordion-body p-4">
                                    <p class="text-muted small mb-3"><%= job.description %></p>
                                    
                                    <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                                        <i class="fa fa-users me-1 text-primary"></i>Artisan Proposals (<%= job.applications ? job.applications.length : 0 %>)
                                    </h6>

                                    <% if (!job.applications || job.applications.length === 0) { %>
                                        <p class="text-muted small mb-0">No proposals submitted yet. Artisans across <%= job.location_county %> are being notified.</p>
                                    <% } else { %>
                                        <div class="table-responsive">
                                            <table class="table align-middle">
                                                <thead class="table-light small">
                                                    <tr>
                                                        <th>Artisan</th>
                                                        <th>Quoted Bid</th>
                                                        <th>Pitch Note</th>
                                                        <th>Status</th>
                                                        <th class="text-end">Actions</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% job.applications.forEach(bid => { %>
                                                        <tr>
                                                            <td>
                                                                <div class="fw-bold text-dark"><%= bid.artisan ? bid.artisan.name : 'Fundi' %></div>
                                                                <small class="text-muted"><%= bid.artisan ? bid.artisan.county : '' %></small>
                                                            </td>
                                                            <td>
                                                                <strong class="text-primary">Ksh <%= Number(bid.bid_amount).toLocaleString() %></strong>
                                                            </td>
                                                            <td>
                                                                <small class="text-muted"><%= bid.pitch_message %></small>
                                                            </td>
                                                            <td>
                                                                <span class="badge <%= bid.status === 'accepted' ? 'bg-success' : (bid.status === 'shortlisted' ? 'bg-warning text-dark' : 'bg-secondary') %> text-uppercase">
                                                                    <%= bid.status %>
                                                                </span>
                                                            </td>
                                                            <td class="text-end">
                                                                <div class="d-inline-flex gap-1 align-items-center">
                                                                    <% 
                                                                        const aPhone = bid.artisan ? bid.artisan.phone.replace(/[^0-9]/g, '') : '254711000000';
                                                                        const waClean = aPhone.startsWith('0') ? '254' + aPhone.slice(1) : aPhone;
                                                                        const waUrl = 'https://wa.me/' + waClean + '?text=' + encodeURIComponent('Hi ' + (bid.artisan ? bid.artisan.name : 'Fundi') + ', regarding your bid of Ksh ' + Number(bid.bid_amount).toLocaleString() + ' on "' + job.title + '" on TopLineHub, let us discuss site start.');
                                                                    %>
                                                                    <a href="<%= waUrl %>" target="_blank" class="btn btn-whatsapp btn-sm" title="WhatsApp Fundi">
                                                                        <i class="fab fa-whatsapp"></i>
                                                                    </a>
                                                                    <% if (bid.artisan && bid.artisan.phone) { %>
                                                                        <a href="tel:<%= bid.artisan.phone %>" class="btn btn-outline-dark btn-sm" title="Call Fundi">
                                                                            <i class="fa fa-phone"></i>
                                                                        </a>
                                                                    <% } %>
                                                                    <!-- Workflow Status Dropdown -->
                                                                    <div class="dropdown">
                                                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                                                            Update
                                                                        </button>
                                                                        <ul class="dropdown-menu dropdown-menu-end">
                                                                            <li>
                                                                                <form action="/jobs/<%= job.id %>/bids/<%= bid.id %>/status" method="POST">
                                                                                    <input type="hidden" name="status" value="shortlisted">
                                                                                    <button type="submit" class="dropdown-item">⭐ Shortlist</button>
                                                                                </form>
                                                                            </li>
                                                                            <li>
                                                                                <form action="/jobs/<%= job.id %>/bids/<%= bid.id %>/status" method="POST">
                                                                                    <input type="hidden" name="status" value="accepted">
                                                                                    <button type="submit" class="dropdown-item text-success fw-bold">✅ Accept Proposal</button>
                                                                                </form>
                                                                            </li>
                                                                            <li>
                                                                                <form action="/jobs/<%= job.id %>/bids/<%= bid.id %>/status" method="POST">
                                                                                    <input type="hidden" name="status" value="rejected">
                                                                                    <button type="submit" class="dropdown-item text-danger">❌ Decline</button>
                                                                                </form>
                                                                            </li>
                                                                        </ul>
                                                                    </div>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    <% }) %>
                                                </tbody>
                                            </table>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>
    </div>
<% } %>

<!-- ========================================== -->
<!-- TAB 4: MATERIALS & PLANT HIRE FLEET -->
<!-- ========================================== -->
<% if (activeTab === 'supplier') { %>
    <div class="dash-card">
        <div class="dash-card-header">
            <div>
                <h5 class="dash-card-title"><i class="fa fa-boxes text-success"></i>My Listed Materials & Plant Machinery</h5>
                <small class="text-muted">Manage your stock, hire fleets, prices, and county coverage.</small>
            </div>
            <a href="/materials/post" class="btn btn-sm btn-success text-white fw-bold">
                <i class="fa fa-plus me-1"></i>Add Material or Plant Hire
            </a>
        </div>
        <div class="dash-card-body">
            <% if (myProducts.length === 0) { %>
                <div class="text-center py-5">
                    <i class="fa fa-truck fa-3x text-muted mb-3 opacity-50"></i>
                    <h5 class="text-dark">No Listings Available</h5>
                    <p class="text-muted small">List cement, steel, timber, or site machinery for hire across Kenya.</p>
                    <a href="/materials/post" class="btn btn-success text-white">List Materials or Equipment</a>
                </div>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead class="table-light small">
                            <tr>
                                <th>Listing Item</th>
                                <th>Category</th>
                                <th>Type</th>
                                <th>Price (KES)</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% myProducts.forEach(product => { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="<%= product.image_url || '/img/service-1.jpg' %>" style="width: 45px; height: 45px; border-radius: 8px; object-fit: cover;" alt="">
                                            <div>
                                                <a href="/materials/<%= product.id %>" class="fw-bold text-dark text-decoration-none"><%= product.title %></a>
                                                <small class="text-muted d-block"><%= product.location_county %></small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border"><%= product.category ? product.category.name : 'General' %></span>
                                    </td>
                                    <td>
                                        <span class="badge <%= product.is_rental ? 'bg-primary' : 'bg-secondary' %> text-uppercase">
                                            <%= product.is_rental ? 'Plant Hire' : 'Material' %>
                                        </span>
                                    </td>
                                    <td>
                                        <strong class="text-dark">Ksh <%= Number(product.price).toLocaleString() %></strong>
                                        <small class="text-muted">/ <%= product.unit %></small>
                                    </td>
                                    <td>
                                        <span class="badge <%= product.is_active ? 'bg-success' : 'bg-danger' %>">
                                            <%= product.is_active ? 'Active' : 'Paused' %>
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <form action="/products/<%= product.id %>/toggle-status" method="POST" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary" title="Toggle Active">
                                                <i class="fa fa-power-off"></i>
                                            </button>
                                        </form>
                                        <form action="/products/<%= product.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Remove listing?')">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </div>
<% } %>

<!-- ========================================== -->
<!-- TAB 5: ORDERS & HIRE ENQUIRIES -->
<!-- ========================================== -->
<% if (activeTab === 'orders') { %>
    <div class="dash-card">
        <div class="dash-card-header">
            <div>
                <h5 class="dash-card-title"><i class="fa fa-clipboard-list text-warning"></i>Incoming Equipment Hire & Material Orders</h5>
                <small class="text-muted">Clients submit requests for your listings. Unlock client contact details by paying the platform commission charge.</small>
            </div>
            <button type="button" class="btn btn-sm btn-warning text-dark fw-bold" data-bs-toggle="modal" data-bs-target="#mpesaTopupModal">
                <i class="fa fa-wallet me-1"></i>Wallet: KES <%= userWallet ? Number(userWallet.balance).toLocaleString() : '100' %>
            </button>
        </div>
        <div class="dash-card-body">
            <% if (incomingInquiries.length === 0) { %>
                <div class="text-center py-5">
                    <i class="fa fa-inbox fa-3x text-muted mb-3 opacity-50"></i>
                    <h5 class="text-dark">No Client Orders Yet</h5>
                    <p class="text-muted small">Incoming equipment hire requests and material quotes will appear here.</p>
                </div>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead class="table-light small">
                            <tr>
                                <th>Order Item</th>
                                <th>Client Delivery Address</th>
                                <th>Total Value</th>
                                <th>Client Contact & WhatsApp</th>
                                <th>Order Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% incomingInquiries.forEach(order => { %>
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark"><%= order.product ? order.product.title : 'Materials' %></div>
                                        <small class="text-muted"><%= order.quantity %> units &bull; Placed: <%= new Date(order.created_at).toLocaleDateString() %></small>
                                    </td>
                                    <td>
                                        <div class="small text-dark fw-bold"><%= order.buyer ? order.buyer.name : 'Client' %></div>
                                        <small class="text-muted"><%= order.delivery_address %></small>
                                    </td>
                                    <td>
                                        <strong class="text-primary">Ksh <%= Number(order.total_price).toLocaleString() %></strong>
                                    </td>
                                    <td>
                                        <!-- PLATFORM COMMISSION CONTACT GATING FOR RENTALS & ORDERS -->
                                        <% if (order.contactUnlocked) { %>
                                            <div class="d-inline-flex flex-wrap gap-2 align-items-center">
                                                <a href="tel:<%= order.buyerPhone %>" class="btn btn-sm btn-dark py-1 px-2">
                                                    <i class="fa fa-phone me-1"></i><%= order.buyerPhone %>
                                                </a>
                                                <!-- WhatsApp button ONLY appears when unlocked! -->
                                                <a href="<%= order.waOrderUrl %>" target="_blank" class="btn btn-sm btn-whatsapp py-1 px-2" title="WhatsApp Client">
                                                    <i class="fab fa-whatsapp me-1"></i>WhatsApp
                                                </a>
                                            </div>
                                        <% } else { %>
                                            <div class="d-flex flex-column gap-1">
                                                <span class="badge bg-light text-muted border text-start">
                                                    <i class="fa fa-lock text-warning me-1"></i><%= order.maskedBuyerPhone %>
                                                </span>
                                                <form action="/unlock/order/<%= order.id %>" method="POST">
                                                    <button type="submit" class="btn btn-unlock-gold btn-sm py-1 px-2" style="font-size: 0.75rem;" title="Pay platform commission charge to reveal client phone & WhatsApp">
                                                        <i class="fa fa-coins me-1"></i>Unlock Contact (Ksh <%= order.unlockPrice %>)
                                                    </button>
                                                </form>
                                            </div>
                                        <% } %>
                                    </td>
                                    <td>
                                        <form action="/orders/<%= order.id %>/status" method="POST" class="d-inline">
                                            <select name="status" class="form-select form-select-sm" onchange="this.form.submit()" style="width: auto;">
                                                <option value="inquiry" <%= order.status === 'inquiry' ? 'selected' : '' %>>Inquiry</option>
                                                <option value="quote_provided" <%= order.status === 'quote_provided' ? 'selected' : '' %>>Quote Sent</option>
                                                <option value="confirmed" <%= order.status === 'confirmed' ? 'selected' : '' %>>Confirmed</option>
                                                <option value="delivered" <%= order.status === 'delivered' ? 'selected' : '' %>>Delivered</option>
                                                <option value="cancelled" <%= order.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                                            </select>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </div>
<% } %>

<!-- ========================================== -->
<!-- TAB 6: WALLET & MONETIZATION LEDGER -->
<!-- ========================================== -->
<% if (activeTab === 'wallet') { %>
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="dash-card bg-dark text-white p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-white-50 small text-uppercase fw-bold">Platform Credits Balance</span>
                    <span class="badge bg-success">Active</span>
                </div>
                <div class="display-5 fw-bold text-warning mb-2">
                    KES <%= userWallet ? Number(userWallet.balance).toLocaleString() : '100' %>
                </div>
                <p class="text-white-50 small mb-4">Top up via M-Pesa to unlock client WhatsApp numbers and phone lines instantly.</p>
                <button type="button" class="btn btn-warning fw-bold text-dark w-100 py-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#mpesaTopupModal">
                    <i class="fa fa-bolt me-1"></i>Top Up Credits (M-Pesa)
                </button>
            </div>

            <!-- Platform Pricing Policy -->
            <div class="dash-card p-4">
                <h6 class="fw-bold text-dark mb-3"><i class="fa fa-tag text-primary me-2"></i>Monetization Fees</h6>
                <div class="d-flex justify-content-between py-2 border-bottom small">
                    <span class="text-muted">Job Client Phone & WhatsApp:</span>
                    <strong class="text-dark">Ksh <%= pricing.UNLOCK_JOB_CLIENT_CONTACT %></strong>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom small">
                    <span class="text-muted">Hire & Order Client Platform Fee:</span>
                    <strong class="text-dark">Ksh <%= pricing.UNLOCK_ORDER_CLIENT_CONTACT %></strong>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom small">
                    <span class="text-muted">Building Material Supplier Contact:</span>
                    <strong class="text-dark">Ksh <%= pricing.UNLOCK_MATERIAL_SUPPLIER_CONTACT %></strong>
                </div>
                <div class="d-flex justify-content-between py-2 small">
                    <span class="text-muted">Verified Fundi Direct Contact:</span>
                    <strong class="text-dark">Ksh <%= pricing.UNLOCK_ARTISAN_CONTACT %></strong>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="dash-card">
                <div class="dash-card-header">
                    <h5 class="dash-card-title"><i class="fa fa-history text-primary"></i>Wallet Transaction Ledger</h5>
                    <span class="badge bg-light text-dark border">Recent 25 items</span>
                </div>
                <div class="dash-card-body p-0">
                    <% if (transactions.length === 0) { %>
                        <div class="p-4 text-center text-muted">
                            <i class="fa fa-receipt fa-2x mb-2 text-secondary opacity-50"></i>
                            <p class="small mb-0">No transactions recorded yet.</p>
                        </div>
                    <% } else { %>
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead class="table-light small">
                                    <tr>
                                        <th>Date</th>
                                        <th>Description</th>
                                        <th>Amount</th>
                                        <th>Balance</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% transactions.forEach(tx => { %>
                                        <tr>
                                            <td class="small text-muted">
                                                <%= new Date(tx.created_at).toLocaleDateString() %>
                                            </td>
                                            <td>
                                                <div class="fw-bold text-dark small"><%= tx.description %></div>
                                                <small class="text-muted"><%= tx.payment_method %></small>
                                            </td>
                                            <td>
                                                <span class="fw-bold <%= tx.type === 'topup' ? 'text-success' : 'text-danger' %>">
                                                    <%= tx.type === 'topup' ? '+' : '-' %> Ksh <%= Number(tx.amount).toLocaleString() %>
                                                </span>
                                            </td>
                                            <td class="small text-dark fw-bold">
                                                Ksh <%= Number(tx.balance_after).toLocaleString() %>
                                            </td>
                                            <td>
                                                <span class="badge bg-success-subtle text-success py-1 px-2" style="font-size: 0.65rem;">
                                                    <%= tx.status %>
                                                </span>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
<% } %>

<!-- ========================================== -->
<!-- TAB 7: EMBEDDED MARKETPLACE HUB -->
<!-- ========================================== -->
<% if (activeTab === 'marketplace') { %>
    <div class="dash-card">
        <div class="dash-card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h5 class="dash-card-title"><i class="fa fa-store text-primary"></i>Live Construction Marketplace</h5>
                <small class="text-muted">Browse building supplies, plant machinery hire, fundis, and open jobs right inside your dashboard.</small>
            </div>
            <!-- Marketplace Navigation Pills -->
            <ul class="nav nav-pills gap-1" id="mktSubTabs" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active btn-sm" id="pills-mats-tab" data-bs-toggle="pill" data-bs-target="#pills-mats" type="button">
                        <i class="fa fa-cubes me-1"></i>Materials (<%= marketplaceMaterials.length %>)
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link btn-sm" id="pills-rentals-tab" data-bs-toggle="pill" data-bs-target="#pills-rentals" type="button">
                        <i class="fa fa-tools me-1"></i>Equipment Hire (<%= marketplaceRentals.length %>)
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link btn-sm" id="pills-fundis-tab" data-bs-toggle="pill" data-bs-target="#pills-fundis" type="button">
                        <i class="fa fa-hard-hat me-1"></i>Fundis (<%= marketplaceFundis.length %>)
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link btn-sm" id="pills-jobs-tab" data-bs-toggle="pill" data-bs-target="#pills-jobs" type="button">
                        <i class="fa fa-briefcase me-1"></i>Jobs (<%= marketplaceJobs.length %>)
                    </button>
                </li>
            </ul>
        </div>
        <div class="dash-card-body">
            <div class="tab-content" id="mktSubTabsContent">
                <!-- 1. MATERIALS -->
                <div class="tab-pane fade show active" id="pills-mats">
                    <div class="row g-3">
                        <% marketplaceMaterials.forEach(item => { %>
                            <div class="col-md-6 col-xl-4">
                                <div class="card h-100 border shadow-sm rounded overflow-hidden">
                                    <img src="<%= item.image_url || '/img/service-1.jpg' %>" style="height: 160px; object-fit: cover;" alt="">
                                    <div class="card-body p-3 d-flex flex-column">
                                        <div class="d-flex justify-content-between mb-1">
                                            <span class="badge bg-light text-dark border"><%= item.category ? item.category.name : 'Supplies' %></span>
                                            <span class="small text-muted"><i class="fa fa-map-marker-alt me-1 text-primary"></i><%= item.location_county %></span>
                                        </div>
                                        <h6 class="fw-bold text-dark mb-1"><%= item.title %></h6>
                                        <div class="fs-5 fw-bold text-dark mb-2">Ksh <%= Number(item.price).toLocaleString() %> <small class="text-muted fw-normal" style="font-size: 0.75rem;">/ <%= item.unit %></small></div>
                                        <div class="mb-2 small">
                                            <span class="text-muted">Vendor: </span>
                                            <% if (item.contactUnlocked) { %>
                                                <strong class="text-dark"><%= item.seller ? item.seller.phone : 'Verified' %></strong>
                                            <% } else { %>
                                                <span class="badge bg-light text-muted border"><i class="fa fa-lock text-warning me-1"></i><%= item.maskedPhone %></span>
                                            <% } %>
                                        </div>
                                        <div class="mt-auto d-flex gap-2">
                                            <a href="/materials/<%= item.id %>" class="btn btn-outline-primary btn-sm fw-bold">View</a>
                                            <a href="/orders/request/<%= item.id %>" class="btn btn-primary text-white btn-sm flex-grow-1 fw-bold">Order Quote</a>
                                            <% if (item.contactUnlocked) { %>
                                                <% 
                                                    const sPhone = item.seller ? item.seller.phone.replace(/[^0-9]/g, '') : '254711000000';
                                                    const waClean = sPhone.startsWith('0') ? '254' + sPhone.slice(1) : sPhone;
                                                %>
                                                <a href="https://wa.me/<%= waClean %>?text=Hi,%20inquiring%20about%20<%= encodeURIComponent(item.title) %>" target="_blank" class="btn btn-whatsapp btn-sm">
                                                    <i class="fab fa-whatsapp"></i>
                                                </a>
                                            <% } else { %>
                                                <form action="/unlock/material/<%= item.id %>" method="POST">
                                                    <button type="submit" class="btn btn-unlock-gold btn-sm" title="Unlock WhatsApp">
                                                        <i class="fa fa-lock me-1"></i>Ksh <%= item.unlockPrice %>
                                                    </button>
                                                </form>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>

                <!-- 2. PLANT & EQUIPMENT HIRE -->
                <div class="tab-pane fade" id="pills-rentals">
                    <div class="row g-3">
                        <% marketplaceRentals.forEach(rental => { %>
                            <div class="col-md-6 col-xl-4">
                                <div class="card h-100 border shadow-sm rounded overflow-hidden">
                                    <img src="<%= rental.image_url || '/img/service-2.jpg' %>" style="height: 160px; object-fit: cover;" alt="">
                                    <div class="card-body p-3 d-flex flex-column">
                                        <div class="d-flex justify-content-between mb-1">
                                            <span class="badge bg-primary text-white">Hire Plant</span>
                                            <span class="small text-muted"><i class="fa fa-map-marker-alt me-1 text-primary"></i><%= rental.location_county %></span>
                                        </div>
                                        <h6 class="fw-bold text-dark mb-1"><%= rental.title %></h6>
                                        <div class="fs-5 fw-bold text-primary mb-2">Ksh <%= Number(rental.price).toLocaleString() %> <small class="text-muted fw-normal" style="font-size: 0.75rem;">/ <%= rental.unit %></small></div>
                                        <div class="mb-2 small">
                                            <span class="text-muted">Owner: </span>
                                            <% if (rental.contactUnlocked) { %>
                                                <strong class="text-dark"><%= rental.seller ? rental.seller.phone : 'Verified' %></strong>
                                            <% } else { %>
                                                <span class="badge bg-light text-muted border"><i class="fa fa-lock text-warning me-1"></i><%= rental.maskedPhone %></span>
                                            <% } %>
                                        </div>
                                        <div class="mt-auto d-flex gap-2">
                                            <a href="/materials/<%= rental.id %>" class="btn btn-outline-primary btn-sm fw-bold">View</a>
                                            <a href="/orders/request/<%= rental.id %>" class="btn btn-primary text-white btn-sm flex-grow-1 fw-bold">Book Hire</a>
                                            <% if (rental.contactUnlocked) { %>
                                                <% 
                                                    const rPhone = rental.seller ? rental.seller.phone.replace(/[^0-9]/g, '') : '254711000000';
                                                    const waClean = rPhone.startsWith('0') ? '254' + rPhone.slice(1) : rPhone;
                                                %>
                                                <a href="https://wa.me/<%= waClean %>?text=Hi,%20inquiring%20about%20hiring%20<%= encodeURIComponent(rental.title) %>" target="_blank" class="btn btn-whatsapp btn-sm">
                                                    <i class="fab fa-whatsapp"></i>
                                                </a>
                                            <% } else { %>
                                                <form action="/unlock/material/<%= rental.id %>" method="POST">
                                                    <button type="submit" class="btn btn-unlock-gold btn-sm" title="Unlock WhatsApp">
                                                        <i class="fa fa-lock me-1"></i>Ksh <%= rental.unlockPrice %>
                                                    </button>
                                                </form>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>

                <!-- 3. FUNDIS & ARTISANS -->
                <div class="tab-pane fade" id="pills-fundis">
                    <div class="row g-3">
                        <% marketplaceFundis.forEach(artisan => { %>
                            <div class="col-md-6 col-xl-4">
                                <div class="card h-100 border shadow-sm p-3 rounded">
                                    <div class="d-flex align-items-center gap-3 mb-2">
                                        <img src="<%= artisan.user && artisan.user.avatar ? artisan.user.avatar : '/img/team-1.jpg' %>" style="width: 50px; height: 50px; border-radius: 10px; object-fit: cover;" alt="">
                                        <div>
                                            <h6 class="fw-bold text-dark mb-0"><%= artisan.user ? artisan.user.name : 'Artisan' %></h6>
                                            <span class="badge bg-warning text-dark py-0 px-2" style="font-size: 0.65rem;"><%= artisan.trade %></span>
                                        </div>
                                    </div>
                                    <p class="text-muted small mb-2"><%= artisan.bio ? artisan.bio.substring(0, 75) + '...' : '' %></p>
                                    <div class="d-flex justify-content-between align-items-center mb-2 small">
                                        <span class="text-muted">Rate: <strong class="text-dark">Ksh <%= Number(artisan.daily_rate).toLocaleString() %>/day</strong></span>
                                        <span class="text-muted"><i class="fa fa-map-marker-alt me-1 text-primary"></i><%= artisan.user ? artisan.user.town : 'Kenya' %></span>
                                    </div>
                                    <div class="mt-auto d-flex gap-2">
                                        <a href="/fundis/<%= artisan.id %>" class="btn btn-outline-primary btn-sm flex-grow-1 fw-bold">Profile</a>
                                        <% if (artisan.contactUnlocked) { %>
                                            <% 
                                                const aPhone = artisan.user ? artisan.user.phone.replace(/[^0-9]/g, '') : '254711000000';
                                                const waClean = aPhone.startsWith('0') ? '254' + aPhone.slice(1) : aPhone;
                                            %>
                                            <a href="https://wa.me/<%= waClean %>" target="_blank" class="btn btn-whatsapp btn-sm">
                                                <i class="fab fa-whatsapp me-1"></i>WhatsApp
                                            </a>
                                        <% } else { %>
                                            <form action="/unlock/artisan/<%= artisan.id %>" method="POST">
                                                <button type="submit" class="btn btn-unlock-gold btn-sm" title="Unlock WhatsApp">
                                                    <i class="fa fa-lock me-1"></i>Ksh <%= artisan.unlockPrice %>
                                                </button>
                                            </form>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>

                <!-- 4. OPEN JOBS -->
                <div class="tab-pane fade" id="pills-jobs">
                    <div class="row g-3">
                        <% marketplaceJobs.forEach(job => { %>
                            <div class="col-12">
                                <div class="border rounded p-3 bg-white d-flex flex-wrap align-items-center justify-content-between gap-3">
                                    <div>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <span class="badge bg-primary"><%= job.trade_required %></span>
                                            <span class="text-muted small"><i class="fa fa-map-marker-alt text-primary me-1"></i><%= job.location_town %>, <%= job.location_county %></span>
                                        </div>
                                        <h6 class="fw-bold text-dark mb-1"><%= job.title %></h6>
                                        <div class="small text-muted">Budget: <strong class="text-primary">Ksh <%= Number(job.budget_estimate).toLocaleString() %></strong></div>
                                    </div>
                                    <div class="d-flex flex-wrap gap-2 align-items-center">
                                        <% if (job.contactUnlocked && job.client) { %>
                                            <span class="badge bg-success-subtle text-success py-2 px-3 border border-success-subtle">
                                                <i class="fa fa-phone me-1"></i><%= job.client.phone %>
                                            </span>
                                            <% 
                                                const clPhone = job.client.phone.replace(/[^0-9]/g, '');
                                                const waClean = clPhone.startsWith('0') ? '254' + clPhone.slice(1) : clPhone;
                                            %>
                                            <a href="https://wa.me/<%= waClean %>" target="_blank" class="btn btn-whatsapp btn-sm">
                                                <i class="fab fa-whatsapp me-1"></i>WhatsApp
                                            </a>
                                        <% } else { %>
                                            <span class="badge bg-light text-muted border py-2 px-3">
                                                <i class="fa fa-lock text-warning me-1"></i><%= job.maskedPhone %>
                                            </span>
                                            <form action="/unlock/job/<%= job.id %>" method="POST" class="d-inline">
                                                <button type="submit" class="btn btn-unlock-gold btn-sm fw-bold">
                                                    <i class="fa fa-lock me-1"></i>Unlock (Ksh <%= job.unlockPrice %>)
                                                </button>
                                            </form>
                                        <% } %>
                                        <a href="/jobs" class="btn btn-primary btn-sm text-white fw-bold">Apply & Bid</a>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>
        </div>
    </div>
<% } %>

<!-- ========================================== -->
<!-- TAB 8: PROFILE SETTINGS -->
<!-- ========================================== -->
<% if (activeTab === 'profile') { %>
    <div class="dash-card">
        <div class="dash-card-header">
            <h5 class="dash-card-title"><i class="fa fa-user-cog text-primary"></i>Account & Profile Settings</h5>
            <span class="badge bg-light text-muted border">ID #<%= currentUser.id %></span>
        </div>
        <div class="dash-card-body">
            <form action="/dashboard/profile" method="POST" enctype="multipart/form-data">
                <div class="row g-4">
                    <div class="col-md-4 text-center">
                        <div class="position-relative d-inline-block mb-3">
                            <img src="<%= currentUser.avatar || '/img/team-1.jpg' %>" id="avatarPreview" alt="Avatar" class="rounded-circle border border-3 border-primary shadow-sm" style="width: 130px; height: 130px; object-fit: cover;">
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-dark">Change Profile Picture</label>
                            <input type="file" name="avatar_file" id="avatarInput" class="form-control form-control-sm" accept="image/*">
                        </div>
                    </div>

                    <div class="col-md-8">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-dark">Full Name</label>
                                <input type="text" name="name" class="form-control" value="<%= currentUser.name %>" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-dark">Email Address</label>
                                <input type="email" class="form-control bg-light" value="<%= currentUser.email %>" readonly>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-dark">Phone Number (M-Pesa / Call)</label>
                                <input type="text" name="phone" class="form-control" value="<%= currentUser.phone %>" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-dark">Primary County</label>
                                <select name="county" class="form-select">
                                    <% counties.forEach(c => { %>
                                        <option value="<%= c %>" <%= currentUser.county === c ? 'selected' : '' %>><%= c %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-dark">Town / Area</label>
                                <input type="text" name="town" class="form-control" value="<%= currentUser.town %>">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-dark">Platform Account Type</label>
                                <input type="text" class="form-control bg-light text-uppercase fw-bold" value="<%= currentUser.role %>" readonly>
                            </div>

                            <% if (currentUser.artisanProfile) { %>
                                <div class="col-12 border-top pt-3">
                                    <h6 class="fw-bold text-dark mb-2"><i class="fa fa-tools me-1 text-primary"></i>Artisan & Trade Details</h6>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-dark">Trade / Specialization</label>
                                    <input type="text" name="trade" class="form-control" value="<%= currentUser.artisanProfile.trade %>">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-dark">Daily Labor Rate (KES)</label>
                                    <input type="number" name="daily_rate" class="form-control" value="<%= currentUser.artisanProfile.daily_rate %>">
                                </div>
                                <div class="col-12">
                                    <label class="form-label small fw-bold text-dark">Professional Bio & Experience</label>
                                    <textarea name="bio" class="form-control" rows="3"><%= currentUser.artisanProfile.bio %></textarea>
                                </div>
                            <% } %>

                            <div class="col-12 mt-4">
                                <button type="submit" class="btn btn-primary text-white fw-bold px-4">
                                    <i class="fa fa-save me-1"></i>Save Profile Changes
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
<% } %>

<!-- ========================================== -->
<!-- TAB 9: ADMIN CONSOLE -->
<!-- ========================================== -->
<% if (activeTab === 'admin' && currentUser.role === 'admin') { %>
    <div class="dash-card">
        <div class="dash-card-header">
            <h5 class="dash-card-title text-danger"><i class="fa fa-shield-alt me-1"></i>Platform Master Administration</h5>
            <span class="badge bg-danger text-white">Superadmin Access</span>
        </div>
        <div class="dash-card-body">
            <!-- Platform Financial & Escrow Counters -->
            <div class="row g-3 mb-4">
                <div class="col-6 col-lg-2">
                    <div class="border rounded p-3 text-center bg-light">
                        <div class="fs-4 fw-bold text-dark"><%= adminData.stats.totalUsers %></div>
                        <small class="text-muted fw-bold">Users</small>
                    </div>
                </div>
                <div class="col-6 col-lg-2">
                    <div class="border rounded p-3 text-center bg-light">
                        <div class="fs-4 fw-bold text-dark"><%= adminData.stats.totalProducts %></div>
                        <small class="text-muted fw-bold">Listings</small>
                    </div>
                </div>
                <div class="col-6 col-lg-2">
                    <div class="border rounded p-3 text-center bg-light">
                        <div class="fs-4 fw-bold text-dark"><%= adminData.stats.totalOrders %></div>
                        <small class="text-muted fw-bold">Orders</small>
                    </div>
                </div>
                <div class="col-6 col-lg-2">
                    <div class="border rounded p-3 text-center bg-warning bg-opacity-10 border-warning">
                        <div class="fs-4 fw-bold text-warning">KES <%= Number(adminData.stats.totalEscrowHeld || 0).toLocaleString() %></div>
                        <small class="text-warning-emphasis fw-bold"><i class="fa fa-lock me-1"></i>Escrow Held</small>
                    </div>
                </div>
                <div class="col-6 col-lg-2">
                    <div class="border rounded p-3 text-center bg-info bg-opacity-10 border-info">
                        <div class="fs-4 fw-bold text-info">KES <%= Number(adminData.stats.totalEscrowReady || 0).toLocaleString() %></div>
                        <small class="text-info fw-bold"><i class="fa fa-clock me-1"></i>Ready for Payout</small>
                    </div>
                </div>
                <div class="col-6 col-lg-2">
                    <div class="border rounded p-3 text-center bg-success bg-opacity-10 border-success">
                        <div class="fs-4 fw-bold text-success">KES <%= Number(adminData.stats.totalCommission || 0).toLocaleString() %></div>
                        <small class="text-success fw-bold"><i class="fa fa-chart-line me-1"></i>Net Commission</small>
                    </div>
                </div>
            </div>

            <!-- ESCROW & PRODUCT PURCHASES DISBURSEMENT QUEUE -->
            <div class="dash-card border shadow-sm mb-4">
                <div class="dash-card-header bg-light d-flex justify-content-between align-items-center py-2 px-3">
                    <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                        <i class="fa fa-hand-holding-usd text-success"></i>
                        <span>Escrow & Supplier Payout Queue</span>
                    </h6>
                    <span class="badge bg-primary text-white">Live Paystack Escrow</span>
                </div>
                <div class="dash-card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Order #</th>
                                    <th>Product & Buyer</th>
                                    <th>Supplier</th>
                                    <th>Total / Fee</th>
                                    <th>Supplier Net Payout</th>
                                    <th>Escrow Status</th>
                                    <th class="text-end">Disbursement Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% const escrowOrders = adminData.orders.filter(o => o.order_type === 'purchase' || o.escrow_status !== 'none'); %>
                                <% if (escrowOrders.length === 0) { %>
                                    <tr>
                                        <td colspan="7" class="text-center py-4 text-muted">
                                            <i class="fa fa-inbox fs-3 d-block mb-2 text-secondary"></i>
                                            No product purchase orders with escrow on record yet.
                                        </td>
                                    </tr>
                                <% } else { %>
                                    <% escrowOrders.forEach(o => { %>
                                        <tr>
                                            <td>
                                                <span class="badge bg-dark fw-bold">#<%= o.id %></span>
                                                <div class="small text-muted"><%= new Date(o.created_at).toLocaleDateString() %></div>
                                            </td>
                                            <td>
                                                <div class="fw-bold text-dark"><%= o.product ? o.product.title : 'Material Item' %> (x<%= o.quantity %>)</div>
                                                <small class="text-muted">
                                                    Buyer: <%= o.buyer ? o.buyer.name : 'Guest' %> &bull; <%= o.contact_phone || (o.buyer ? o.buyer.phone : '') %>
                                                </small>
                                            </td>
                                            <td>
                                                <% const seller = o.product && o.product.seller ? o.product.seller : null; %>
                                                <% if (seller) { %>
                                                    <div class="fw-bold text-dark"><%= seller.name %></div>
                                                    <small class="text-muted"><%= seller.phone %></small>
                                                <% } else { %>
                                                    <span class="text-muted">Platform / Direct</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <div class="fw-bold text-dark">KES <%= Number(o.total_price).toLocaleString() %></div>
                                                <small class="text-muted">Fee: KES <%= Number(o.platform_fee || 0).toLocaleString() %></small>
                                            </td>
                                            <td>
                                                <div class="fw-bold text-success fs-6">KES <%= Number(o.seller_payout_amount || 0).toLocaleString() %></div>
                                            </td>
                                            <td>
                                                <% if (o.escrow_status === 'held') { %>
                                                    <span class="badge bg-warning text-dark py-1 px-2">
                                                        <i class="fa fa-lock me-1"></i>Held in Escrow
                                                    </span>
                                                    <div class="small text-muted mt-1">Awaiting delivery</div>
                                                <% } else if (o.escrow_status === 'released') { %>
                                                    <span class="badge bg-info text-dark py-1 px-2">
                                                        <i class="fa fa-check-circle me-1"></i>Buyer Confirmed
                                                    </span>
                                                    <div class="small text-success fw-bold mt-1">Ready for Payout!</div>
                                                <% } else if (o.escrow_status === 'disbursed') { %>
                                                    <span class="badge bg-success py-1 px-2">
                                                        <i class="fa fa-coins me-1"></i>Disbursed
                                                    </span>
                                                    <div class="small text-muted mt-1"><%= o.disbursement_date ? new Date(o.disbursement_date).toLocaleDateString() : 'Paid' %></div>
                                                <% } else { %>
                                                    <span class="badge bg-secondary">None</span>
                                                <% } %>
                                            </td>
                                            <td class="text-end">
                                                <% if (o.escrow_status === 'released') { %>
                                                    <form action="/admin/orders/<%= o.id %>/disburse-escrow" method="POST" class="d-inline" onsubmit="return confirm('Disburse KES <%= Number(o.seller_payout_amount).toLocaleString() %> to supplier wallet?');">
                                                        <button type="submit" class="btn btn-sm btn-success fw-bold py-1 px-2 shadow-sm">
                                                            <i class="fa fa-paper-plane me-1"></i>Disburse Payout
                                                        </button>
                                                    </form>
                                                <% } else if (o.escrow_status === 'held') { %>
                                                    <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2" disabled title="Awaiting buyer delivery confirmation">
                                                        <i class="fa fa-hourglass-half me-1"></i>Awaiting Buyer
                                                    </button>
                                                <% } else if (o.escrow_status === 'disbursed') { %>
                                                    <span class="text-success small fw-bold">
                                                        <i class="fa fa-check-double me-1"></i>Completed
                                                    </span>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- User Moderation Table -->
            <h6 class="fw-bold text-dark mb-2">Registered Users Management</h6>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead class="table-light small">
                        <tr>
                            <th>User Name</th>
                            <th>Role</th>
                            <th>Location</th>
                            <th>Status</th>
                            <th class="text-end">Verification</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% adminData.users.slice(0, 15).forEach(u => { %>
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark"><%= u.name %></div>
                                    <small class="text-muted"><%= u.phone %> &bull; <%= u.email %></small>
                                </td>
                                <td><span class="badge bg-secondary text-uppercase"><%= u.role %></span></td>
                                <td class="small text-muted"><%= u.town %>, <%= u.county %></td>
                                <td>
                                    <span class="badge <%= u.is_verified ? 'bg-success' : 'bg-warning text-dark' %>">
                                        <%= u.is_verified ? 'Verified' : 'Unverified' %>
                                    </span>
                                </td>
                                <td class="text-end">
                                    <form action="/admin/users/<%= u.id %>/toggle-verify" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-sm <%= u.is_verified ? 'btn-outline-warning' : 'btn-outline-success' %> py-1 px-2" style="font-size: 0.75rem;">
                                            <%= u.is_verified ? 'Unverify' : 'Verify' %>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
<% } %>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const avatarInput = document.getElementById('avatarInput');
    const avatarPreview = document.getElementById('avatarPreview');
    if (avatarInput && avatarPreview) {
        avatarInput.addEventListener('change', function() {
            if (this.files && this.files[0]) {
                const reader = new FileReader();
                reader.onload = (e) => { avatarPreview.src = e.target.result; };
                reader.readAsDataURL(this.files[0]);
            }
        });
    }
});
</script>

<!-- Wallet & Credits Page -->
<div class="container-fluid py-5 bg-light" style="min-height: 100vh;">
    <div class="container">
        <!-- Page Header -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="fw-bold text-dark mb-1">
                            <i class="fas fa-wallet text-primary me-2"></i>My Wallet & Credits
                        </h2>
                        <p class="text-muted mb-0">Manage your TopLineHub credits and unlock contacts</p>
                    </div>
                    <a href="/dashboard" class="btn btn-outline-dark">
                        <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
                    </a>
                </div>
            </div>
        </div>

        <!-- Balance Cards -->
        <div class="row g-4 mb-4">
            <!-- Current Balance -->
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <div class="card-body text-white p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <p class="mb-1 opacity-75">Available Balance</p>
                                <h2 class="fw-bold mb-0">Ksh <%= parseFloat(wallet.balance).toLocaleString() %></h2>
                            </div>
                            <div class="bg-white bg-opacity-25 rounded-circle p-3">
                                <i class="fas fa-coins fa-2x"></i>
                            </div>
                        </div>
                        <button class="btn btn-light btn-sm w-100 fw-bold" data-bs-toggle="modal" data-bs-target="#topupModal">
                            <i class="fas fa-plus me-2"></i>Top Up Credits
                        </button>
                    </div>
                </div>
            </div>

            <!-- Total Spent -->
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <p class="text-muted mb-1">Total Spent</p>
                                <h3 class="fw-bold text-dark mb-0">Ksh <%= parseFloat(wallet.total_spent).toLocaleString() %></h3>
                            </div>
                            <div class="bg-danger bg-opacity-10 rounded-circle p-3">
                                <i class="fas fa-arrow-down text-danger fa-lg"></i>
                            </div>
                        </div>
                        <small class="text-muted">Lifetime contact unlocks</small>
                    </div>
                </div>
            </div>

            <!-- Total Topped Up -->
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <p class="text-muted mb-1">Total Topped Up</p>
                                <h3 class="fw-bold text-dark mb-0">Ksh <%= parseFloat(wallet.total_topped_up).toLocaleString() %></h3>
                            </div>
                            <div class="bg-success bg-opacity-10 rounded-circle p-3">
                                <i class="fas fa-arrow-up text-success fa-lg"></i>
                            </div>
                        </div>
                        <small class="text-muted">Lifetime deposits</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pricing Info -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3">
                            <i class="fas fa-tag text-primary me-2"></i>Contact Unlock Pricing
                        </h5>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="d-flex align-items-center p-3 bg-light rounded">
                                    <div class="bg-primary bg-opacity-10 rounded p-3 me-3">
                                        <i class="fas fa-briefcase text-primary fa-lg"></i>
                                    </div>
                                    <div>
                                        <p class="mb-0 small text-muted">Job Client Contact</p>
                                        <h5 class="fw-bold mb-0 text-dark">Ksh <%= pricing.UNLOCK_JOB_CLIENT_CONTACT %></h5>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="d-flex align-items-center p-3 bg-light rounded">
                                    <div class="bg-success bg-opacity-10 rounded p-3 me-3">
                                        <i class="fas fa-box text-success fa-lg"></i>
                                    </div>
                                    <div>
                                        <p class="mb-0 small text-muted">Material Supplier</p>
                                        <h5 class="fw-bold mb-0 text-dark">Ksh <%= pricing.UNLOCK_MATERIAL_SUPPLIER_CONTACT %></h5>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="d-flex align-items-center p-3 bg-light rounded">
                                    <div class="bg-warning bg-opacity-10 rounded p-3 me-3">
                                        <i class="fas fa-hard-hat text-warning fa-lg"></i>
                                    </div>
                                    <div>
                                        <p class="mb-0 small text-muted">Artisan / Fundi</p>
                                        <h5 class="fw-bold mb-0 text-dark">Ksh <%= pricing.UNLOCK_ARTISAN_CONTACT %></h5>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabs: Transactions & Unlocked Contacts -->
        <div class="row">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-0">
                        <ul class="nav nav-tabs border-bottom px-4 pt-3" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active fw-bold" data-bs-toggle="tab" href="#transactions">
                                    <i class="fas fa-history me-2"></i>Transaction History
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link fw-bold" data-bs-toggle="tab" href="#unlocked">
                                    <i class="fas fa-unlock me-2"></i>Unlocked Contacts
                                </a>
                            </li>
                        </ul>

                        <div class="tab-content p-4">
                            <!-- Transactions Tab -->
                            <div id="transactions" class="tab-pane fade show active">
                                <% if (transactions.length === 0) { %>
                                    <div class="text-center py-5">
                                        <i class="fas fa-receipt fa-3x text-muted mb-3"></i>
                                        <p class="text-muted">No transactions yet</p>
                                    </div>
                                <% } else { %>
                                    <div class="table-responsive">
                                        <table class="table table-hover">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Date</th>
                                                    <th>Description</th>
                                                    <th>Type</th>
                                                    <th class="text-end">Amount</th>
                                                    <th class="text-end">Balance</th>
                                                    <th>Status</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% transactions.forEach(txn => { %>
                                                    <tr>
                                                        <td class="text-muted small">
                                                            <%= new Date(txn.created_at).toLocaleDateString() %>
                                                            <br>
                                                            <small><%= new Date(txn.created_at).toLocaleTimeString() %></small>
                                                        </td>
                                                        <td><%= txn.description %></td>
                                                        <td>
                                                            <% if (txn.type === 'topup') { %>
                                                                <span class="badge bg-success">Top Up</span>
                                                            <% } else { %>
                                                                <span class="badge bg-primary">Unlock</span>
                                                            <% } %>
                                                        </td>
                                                        <td class="text-end fw-bold <%= txn.type === 'topup' ? 'text-success' : 'text-danger' %>">
                                                            <%= txn.type === 'topup' ? '+' : '-' %> Ksh <%= parseFloat(txn.amount).toLocaleString() %>
                                                        </td>
                                                        <td class="text-end text-muted">
                                                            Ksh <%= parseFloat(txn.balance_after).toLocaleString() %>
                                                        </td>
                                                        <td>
                                                            <% if (txn.status === 'completed') { %>
                                                                <i class="fas fa-check-circle text-success"></i>
                                                            <% } else if (txn.status === 'pending') { %>
                                                                <i class="fas fa-clock text-warning"></i>
                                                            <% } else { %>
                                                                <i class="fas fa-times-circle text-danger"></i>
                                                            <% } %>
                                                        </td>
                                                    </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                    </div>
                                <% } %>
                            </div>

                            <!-- Unlocked Contacts Tab -->
                            <div id="unlocked" class="tab-pane fade">
                                <% if (unlockedContacts.length === 0) { %>
                                    <div class="text-center py-5">
                                        <i class="fas fa-lock-open fa-3x text-muted mb-3"></i>
                                        <p class="text-muted">No contacts unlocked yet</p>
                                    </div>
                                <% } else { %>
                                    <div class="list-group list-group-flush">
                                        <% unlockedContacts.forEach(unlock => { %>
                                            <div class="list-group-item">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div>
                                                        <h6 class="mb-1 fw-bold">
                                                            <% if (unlock.unlock_type === 'job_client') { %>
                                                                <i class="fas fa-briefcase text-primary me-2"></i>Job Client
                                                            <% } else if (unlock.unlock_type === 'material_supplier') { %>
                                                                <i class="fas fa-box text-success me-2"></i>Material Supplier
                                                            <% } else { %>
                                                                <i class="fas fa-hard-hat text-warning me-2"></i>Artisan / Fundi
                                                            <% } %>
                                                        </h6>
                                                        <p class="mb-0 small text-muted">
                                                            Unlocked <%= new Date(unlock.unlocked_at).toLocaleDateString() %> at <%= new Date(unlock.unlocked_at).toLocaleTimeString() %>
                                                        </p>
                                                    </div>
                                                    <div class="text-end">
                                                        <p class="mb-0 fw-bold text-danger">-Ksh <%= parseFloat(unlock.amount_paid).toFixed(2) %></p>
                                                        <small class="text-muted">ID: #<%= unlock.target_id %></small>
                                                    </div>
                                                </div>
                                            </div>
                                        <% }) %>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Top-Up Modal (Paystack Integrated) -->
<div class="modal fade" id="topupModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; overflow: hidden;">
            <div class="modal-header p-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <div>
                    <h5 class="modal-title fw-bold text-white mb-1">
                        <i class="fas fa-bolt text-warning me-2"></i>Top Up Wallet Credits
                    </h5>
                    <p class="small text-white-50 mb-0">Credits unlock client WhatsApp & phone numbers.</p>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/wallet/paystack/initialize" method="POST" id="walletTopupForm">
                <div class="modal-body p-4">
                    <div class="alert alert-info d-flex align-items-center gap-3 py-2 px-3 mb-3 border-0" style="background: #eef6ff;">
                        <i class="fas fa-shield-alt fs-4 text-primary"></i>
                        <div class="small">
                            <strong>Secure Payment via Paystack</strong> — Card, M-Pesa, Bank Transfer & more. Your payment is encrypted and processed securely.
                        </div>
                    </div>

                    <!-- Payment Method Selector -->
                    <label class="form-label fw-bold text-dark small mb-2">Payment Method:</label>
                    <div class="d-flex gap-2 mb-3">
                        <label class="flex-grow-1 border rounded p-2 d-flex align-items-center gap-2 cursor-pointer bg-light" id="walletPaystackLabel" style="border-color: #667eea !important;">
                            <input type="radio" name="topup_gateway" value="paystack" checked onchange="switchWalletGateway('paystack')">
                            <div>
                                <strong class="text-dark d-block small"><i class="fas fa-shield-alt text-primary me-1"></i>Paystack Gateway</strong>
                                <small class="text-muted" style="font-size: 0.68rem;">Card, M-Pesa, Bank, Apple Pay</small>
                            </div>
                        </label>
                        <label class="flex-grow-1 border rounded p-2 d-flex align-items-center gap-2 cursor-pointer" id="walletMpesaLabel">
                            <input type="radio" name="topup_gateway" value="mpesa" onchange="switchWalletGateway('mpesa')">
                            <div>
                                <strong class="text-dark d-block small"><i class="fas fa-mobile-alt text-success me-1"></i>Direct M-Pesa STK</strong>
                                <small class="text-muted" style="font-size: 0.68rem;">Instant phone PIN prompt</small>
                            </div>
                        </label>
                    </div>

                    <!-- Amount Selection -->
                    <label class="form-label fw-bold text-dark small mb-2">Select Top-Up Package (KES):</label>
                    <div class="row g-2 mb-3">
                        <% pricing.TOPUP_OPTIONS.forEach((option, idx) => { %>
                            <div class="col-4">
                                <label class="w-100 border rounded p-2 text-center wallet-pkg-card cursor-pointer<%= idx === 0 ? ' selected' : '' %>">
                                    <input type="radio" name="amount" value="<%= option.amount %>" class="d-none" <%= idx === 0 ? 'checked' : '' %> onchange="selectWalletPkg(this)">
                                    <div class="fw-bold text-dark">Ksh <%= option.amount.toLocaleString() %></div>
                                    <% if (option.amount === 1) { %>
                                        <small class="badge bg-primary text-white d-inline-block px-1" style="font-size: 0.65rem;">Live Test</small>
                                    <% } else if (option.bonus > 0) { %>
                                        <small class="text-success fw-bold d-block" style="font-size: 0.7rem;">+<%= option.bonus.toLocaleString() %> Bonus</small>
                                    <% } else { %>
                                        <small class="text-muted d-block" style="font-size: 0.7rem;">Starter</small>
                                    <% } %>
                                </label>
                            </div>
                        <% }) %>
                    </div>

                    <!-- M-Pesa Phone (hidden by default) -->
                    <div class="mb-3 d-none" id="walletMpesaPhoneField">
                        <label class="form-label fw-bold text-dark small">M-Pesa Mobile Number</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light fw-bold text-success"><i class="fas fa-mobile-alt me-1"></i>+254</span>
                            <input type="text" name="mpesa_phone" class="form-control" placeholder="712345678" value="<%= user && user.phone ? user.phone.replace(/[^0-9]/g, '').slice(-9) : '' %>">
                        </div>
                        <small class="text-muted" style="font-size: 0.75rem;">An M-Pesa SIM prompt will trigger on your handset.</small>
                    </div>
                </div>
                <div class="modal-footer bg-light p-3">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" id="walletTopupSubmitBtn" class="btn fw-bold text-white px-4 shadow-sm" style="background: linear-gradient(135deg, #667eea, #764ba2);">
                        <i class="fas fa-lock me-1"></i>Pay via Paystack
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
.btn-check:checked + .btn-outline-primary {
    background-color: #0d6efd;
    color: white;
}
.wallet-pkg-card {
    cursor: pointer;
    transition: all 0.2s ease;
    background: #fff;
}
.wallet-pkg-card:hover {
    border-color: #667eea !important;
    background: #f8f7ff;
}
.wallet-pkg-card.selected {
    border-color: #667eea !important;
    background: #f0eeff;
    box-shadow: 0 0 0 2px rgba(102, 126, 234, 0.25);
}
.cursor-pointer { cursor: pointer; }
</style>

<script>
function switchWalletGateway(gw) {
    const form = document.getElementById('walletTopupForm');
    const mpesaField = document.getElementById('walletMpesaPhoneField');
    const submitBtn = document.getElementById('walletTopupSubmitBtn');
    const paystackLabel = document.getElementById('walletPaystackLabel');
    const mpesaLabel = document.getElementById('walletMpesaLabel');

    if (gw === 'paystack') {
        if (form) form.action = '/wallet/paystack/initialize';
        if (mpesaField) mpesaField.classList.add('d-none');
        if (submitBtn) {
            submitBtn.style.background = 'linear-gradient(135deg, #667eea, #764ba2)';
            submitBtn.className = 'btn fw-bold text-white px-4 shadow-sm';
            submitBtn.style.background = 'linear-gradient(135deg, #667eea, #764ba2)';
            submitBtn.innerHTML = '<i class="fas fa-lock me-1"></i>Pay via Paystack';
        }
        if (paystackLabel) { paystackLabel.classList.add('bg-light'); paystackLabel.style.borderColor = '#667eea'; }
        if (mpesaLabel) { mpesaLabel.classList.remove('bg-light'); mpesaLabel.style.borderColor = '#dee2e6'; }
    } else {
        if (form) form.action = '/wallet/topup';
        if (mpesaField) mpesaField.classList.remove('d-none');
        if (submitBtn) {
            submitBtn.className = 'btn btn-success fw-bold text-white px-4 shadow-sm';
            submitBtn.style.background = '';
            submitBtn.innerHTML = '<i class="fas fa-mobile-alt me-1"></i>Send M-Pesa PIN Prompt';
        }
        if (mpesaLabel) { mpesaLabel.classList.add('bg-light'); mpesaLabel.style.borderColor = '#198754'; }
        if (paystackLabel) { paystackLabel.classList.remove('bg-light'); paystackLabel.style.borderColor = '#dee2e6'; }
    }
}

function selectWalletPkg(input) {
    document.querySelectorAll('.wallet-pkg-card').forEach(card => card.classList.remove('selected'));
    if (input && input.closest) input.closest('.wallet-pkg-card').classList.add('selected');
}
</script>


<%- include('partials/header') %>
<%- include('partials/nav') %>

<style>
    .page-layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        align-items: start;
        padding: 48px 0;
    }

    .page-hero-compact {
        background: var(--navy);
        color: #fff;
        padding: 28px 0;
        text-align: center;
    }

    .page-hero-compact .tag { margin-bottom: 6px; }

    .page-hero-compact h1 {
        font-size: clamp(22px, 3vw, 34px);
        font-weight: 800;
        margin: 0;
        line-height: 1.2;
    }

    .page-hero-compact h1 span { color: var(--gold); }

    .page-hero-compact p {
        color: #cfdcee;
        margin: 8px 0 0;
        font-size: 15px;
    }

    .page-info-card {
        background: var(--navy);
        color: #fff;
        border-radius: 18px;
        padding: 36px;
    }

    .page-info-card h2 {
        color: #fff;
        font-size: 24px;
        margin-bottom: 6px;
    }

    .page-info-card .info-subtitle {
        color: #b6c7dc;
        margin-bottom: 28px;
        font-size: 15px;
    }

    .page-info-card .info-item {
        display: flex;
        gap: 16px;
        margin-bottom: 24px;
        align-items: flex-start;
    }

    .page-info-card .info-icon {
        width: 44px;
        height: 44px;
        min-width: 44px;
        border-radius: 12px;
        background: rgba(245, 166, 35, 0.15);
        color: var(--gold);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .page-info-card .info-text h3 {
        font-size: 16px;
        font-weight: 700;
        margin: 0 0 4px;
        color: #fff;
    }

    .page-info-card .info-text p {
        font-size: 14px;
        color: #b6c7dc;
        margin: 0;
        line-height: 1.5;
    }

    .page-info-card .details-box {
        background: rgba(255,255,255,0.06);
        border-radius: 12px;
        padding: 20px;
        margin-top: 24px;
        border: 1px solid rgba(255,255,255,0.08);
    }

    .page-info-card .details-box h3 {
        font-size: 15px;
        font-weight: 700;
        margin: 0 0 10px;
        color: var(--gold);
    }

    .page-info-card .details-box li {
        color: #cfdcee;
        margin: 8px 0 8px 16px;
        font-size: 14px;
        line-height: 1.5;
    }

    .page-form-card {
        background: #fff;
        border: 2px solid var(--ln);
        border-radius: 18px;
        padding: 36px;
        box-shadow: 0 8px 32px rgba(11, 58, 110, 0.08);
    }

    .page-form-card h2 {
        font-size: 24px;
        margin-bottom: 4px;
        color: var(--navy);
    }

    .page-form-card .form-subtitle {
        color: var(--mu);
        margin-bottom: 20px;
        font-size: 15px;
    }

    .page-form-card label {
        display: block;
        font-weight: 600;
        font-size: 14px;
        margin: 14px 0 4px;
        color: var(--tx);
    }

    .page-form-card input,
    .page-form-card select,
    .page-form-card textarea {
        width: 100%;
        padding: 13px 16px;
        border: 1px solid var(--ln);
        border-radius: 10px;
        font: inherit;
        background: var(--card);
        color: var(--tx);
        transition: border-color 0.2s;
    }

    .page-form-card input:focus,
    .page-form-card select:focus,
    .page-form-card textarea:focus {
        outline: none;
        border-color: var(--gold);
    }

    .page-form-card .two {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    .page-form-card .submit-btn {
        width: 100%;
        margin-top: 20px;
        padding: 16px;
        font-size: 16px;
        font-weight: 700;
        background: var(--navy);
        color: #fff;
        border: none;
        border-radius: 12px;
        cursor: pointer;
        transition: background 0.2s, transform 0.1s;
    }

    .page-form-card .submit-btn:hover {
        background: var(--navy2);
        transform: translateY(-1px);
    }

    @media (max-width: 800px) {
        .page-layout {
            grid-template-columns: 1fr;
            gap: 24px;
            padding: 28px 0;
        }
    }
</style>

<!-- Compact Hero Strip -->
<div class="page-hero-compact">
    <div class="w">
        <div class="tag">MATERIALS MARKETPLACE</div>
        <h1>Construction materials. <span>Online.</span></h1>
        <p>Suppliers: list your products. Buyers: browse and order, payment via M-PESA.</p>
    </div>
</div>

<section>
    <div class="w">
        <div class="page-layout">
            <!-- LEFT: How It Works -->
            <div class="page-info-card">
                <h2>How It Works</h2>
                <p class="info-subtitle">Start selling construction materials on TopLine</p>

                <div class="info-item">
                    <div class="info-icon"><i class="fas fa-store"></i></div>
                    <div class="info-text">
                        <h3>1. Sign Up as a Supplier</h3>
                        <p>Register your business and tell us what materials you supply — cement, steel, roofing, tiles, paint and more.</p>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon"><i class="fas fa-cubes"></i></div>
                    <div class="info-text">
                        <h3>2. List Your Products</h3>
                        <p>Add your products with descriptions, prices and photos. Your listings go live on our marketplace instantly.</p>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon"><i class="fas fa-cart-shopping"></i></div>
                    <div class="info-text">
                        <h3>3. Receive Orders</h3>
                        <p>Contractors and homeowners browse and order from you. You get notified instantly when someone buys.</p>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon"><i class="fas fa-mobile-screen-button"></i></div>
                    <div class="info-text">
                        <h3>4. Get Paid via M-PESA</h3>
                        <p>Secure payments processed through M-PESA. Funds are sent directly to your account after delivery.</p>
                    </div>
                </div>

                <div class="details-box">
                    <h3><i class="fas fa-boxes-stacked"></i> Popular Categories</h3>
                    <ul>
                        <li>Cement — Bamburi, Simba, Savannah brands</li>
                        <li>Steel — rebars, BRC, binding wire</li>
                        <li>Roofing — mabati, timber, gutters</li>
                        <li>Tiles, paint, plumbing & electrical fittings</li>
                    </ul>
                </div>
            </div>

            <!-- RIGHT: Supplier Signup Form -->
            <div class="page-form-card">
                <h2><i class="fas fa-box-open" style="color:var(--gold);margin-right:8px"></i> List Your Materials</h2>
                <p class="form-subtitle">Reach more customers. Cement, steel, roofing, paint, tiles.</p>

                <form id="supplierSignupForm" onsubmit="return submitSupplierSignup(event)">
                    <label>Business / supplier name *</label>
                    <input name="business_name" type="text" placeholder="Enter your business name" required>

                    <label>Contact person name</label>
                    <input name="contact_name" type="text" placeholder="Your name">

                    <div class="two">
                        <div>
                            <label>Contact phone *</label>
                            <input name="phone" type="tel" placeholder="0712345678" required>
                        </div>
                        <div>
                            <label>Email</label>
                            <input name="email" type="email" placeholder="your@email.com">
                        </div>
                    </div>

                    <label>Location *</label>
                    <input name="location" type="text" placeholder="e.g. Nairobi, Industrial Area" required>

                    <label>What do you supply? *</label>
                    <textarea name="products_supplied" rows="3" placeholder="List your product categories (e.g., Cement, Steel bars, Roofing materials, Paint, Tiles)" required></textarea>

                    <label>Delivery available? *</label>
                    <select name="delivery_available" required>
                        <option value="">Select option</option>
                        <option value="Yes - we deliver">Yes - we deliver</option>
                        <option value="No - pickup only">No - pickup only</option>
                        <option value="Depends on location">Depends on location</option>
                    </select>

                    <button class="submit-btn" type="submit" id="supplierSignupBtn">
                        <i class="fas fa-paper-plane"></i> Sign Up as Supplier
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>


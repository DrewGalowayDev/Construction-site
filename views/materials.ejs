<%- include('partials/header') %>
<%- include('partials/nav') %>

<header class="hero s">
    <div class="w">
        <div class="tag">MATERIALS MARKETPLACE</div>
        <h1>Construction materials. <span>Online.</span></h1>
        <p>Suppliers: list your products. Buyers: browse and order, payment via M-PESA.</p>
    </div>
</header>

<% if (products && products.length > 0) { %>
<section>
    <div class="w">
        <h2 style="text-align:center">Available Construction Materials</h2>
        <p class="sub" style="text-align:center">Browse products from verified suppliers</p>
        <div class="grid">
            <% products.forEach(product => { %>
            <div class="c">
                <div class="ic">🧱</div>
                <b><%= product.name %></b>
                <p class="sub" style="margin:4px 0 0"><%= product.description || 'Quality construction material' %></p>
                <% if (product.category) { %>
                <p class="sub" style="margin:4px 0 0;font-size:12px">Category: <%= product.category.name %></p>
                <% } %>
                <p style="margin-top:8px;font-weight:700;color:var(--gold)">
                    KSh <%= product.price ? product.price.toLocaleString() : 'Contact for price' %>
                </p>
                <% if (product.seller) { %>
                <p class="sub" style="margin:2px 0 0;font-size:12px">Supplier: <%= product.seller.name %></p>
                <% } %>
                <% if (product.location) { %>
                <p class="sub" style="margin:2px 0 0;font-size:12px">📍 <%= product.location %></p>
                <% } %>
            </div>
            <% }) %>
        </div>
    </div>
</section>
<% } else { %>
<section>
    <div class="w" style="text-align:center;padding:60px 20px">
        <h2>No products listed yet</h2>
        <p class="sub">Be the first supplier to list your construction materials!</p>
    </div>
</section>
<% } %>

<section class="alt">
    <div class="w">
        <h2 style="text-align:center">List your construction materials</h2>
        <p class="sub" style="text-align:center">Cement, steel, roofing, paint, tiles. Reach more customers.</p>
        <form class="fm" onsubmit="return send(event,'Materials supplier signup','Signup sent. We will contact you to list your products.')">
            <label>Business / supplier name</label>
            <input name="Business" type="text" placeholder="" required>
            
            <div class="two">
                <div>
                    <label>Contact phone</label>
                    <input name="Phone" type="tel" placeholder="" required>
                </div>
                <div>
                    <label>Location</label>
                    <input name="Location" type="text" placeholder="" required>
                </div>
            </div>
            
            <label>What do you supply?</label>
            <textarea name="Products" rows="3" placeholder="List your product categories" required></textarea>
            
            <label>Delivery available?</label>
            <select name="Delivery" required>
                <option>Yes - we deliver</option>
                <option>No - pickup only</option>
            </select>
            
            <div style="height:16px"></div>
            <button class="btn n" style="width:100%">Sign up as supplier</button>
        </form>
    </div>
</section>

<%- include('partials/footer') %>

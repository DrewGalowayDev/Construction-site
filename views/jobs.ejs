<%- include('partials/header') %>
<%- include('partials/nav') %>

<header class="hero s">
    <div class="w">
        <div class="tag">JOBS</div>
        <h1>Post a job. <span>Get quotes.</span></h1>
        <p>Describe your project, and TopLine-verified providers will bid. Pick the best.</p>
    </div>
</header>

<% if (jobs && jobs.length > 0) { %>
<section>
    <div class="w">
        <h2 style="text-align:center">Open Job Postings</h2>
        <p class="sub" style="text-align:center">Available jobs from clients</p>
        <div class="grid">
            <% jobs.forEach(job => { %>
            <div class="c">
                <div class="ic">📋</div>
                <b><%= job.title %></b>
                <p class="sub" style="margin:4px 0 0">
                    <%= job.description ? (job.description.length > 120 ? job.description.substring(0, 120) + '...' : job.description) : 'Job details available' %>
                </p>
                <% if (job.budget) { %>
                <p style="margin-top:8px;font-weight:700;color:var(--gold)">
                    Budget: KSh <%= job.budget.toLocaleString() %>
                </p>
                <% } %>
                <% if (job.location) { %>
                <p class="sub" style="margin:2px 0 0;font-size:12px">📍 <%= job.location %></p>
                <% } %>
                <% if (job.category) { %>
                <p class="sub" style="margin:2px 0 0;font-size:12px">Category: <%= job.category %></p>
                <% } %>
                <p class="sub" style="margin:6px 0 0;font-size:12px">Posted <%= new Date(job.created_at).toLocaleDateString() %></p>
            </div>
            <% }) %>
        </div>
    </div>
</section>
<% } else { %>
<section>
    <div class="w" style="text-align:center;padding:60px 20px">
        <h2>No active jobs yet</h2>
        <p class="sub">Be the first to post a job and get quotes from providers!</p>
    </div>
</section>
<% } %>

<section class="alt">
    <div class="w">
        <h2 style="text-align:center">Post your job</h2>
        <p class="sub" style="text-align:center">Providers in your area will see it and send you quotes.</p>
        <form class="fm" onsubmit="return send(event,'Job post','Job posted. Providers will contact you with quotes.')">
            <label>Full name</label>
            <input name="Name" type="text" placeholder="" required>
            
            <div class="two">
                <div>
                    <label>Phone / WhatsApp</label>
                    <input name="Phone" type="tel" placeholder="" required>
                </div>
                <div>
                    <label>Area / town</label>
                    <input name="Location" type="text" placeholder="" required>
                </div>
            </div>
            
            <label>Job category</label>
            <select name="Category" required>
                <option>Cleaning</option>
                <option>Construction</option>
                <option>Plumbing</option>
                <option>Electrical</option>
                <option>Painting</option>
                <option>Repairs</option>
                <option>Other</option>
            </select>
            
            <label>Job description</label>
            <textarea name="Description" rows="4" placeholder="Describe the work that needs doing" required></textarea>
            
            <label>Budget (KSh)</label>
            <input name="Budget" type="text" placeholder="e.g. 10,000 or negotiable">
            
            <div style="height:16px"></div>
            <button class="btn n" style="width:100%">Post job</button>
        </form>
    </div>
</section>

<%- include('partials/footer') %>

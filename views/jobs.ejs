<%- include('partials/header') %>
<%- include('partials/nav') %>

<style>
    .page-layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        align-items: start;
        padding: 48px 0;
    }

    .page-hero-compact {
        background: var(--navy);
        color: #fff;
        padding: 28px 0;
        text-align: center;
    }

    .page-hero-compact .tag { margin-bottom: 6px; }

    .page-hero-compact h1 {
        font-size: clamp(22px, 3vw, 34px);
        font-weight: 800;
        margin: 0;
        line-height: 1.2;
    }

    .page-hero-compact h1 span { color: var(--gold); }

    .page-hero-compact p {
        color: #cfdcee;
        margin: 8px 0 0;
        font-size: 15px;
    }

    .page-info-card {
        background: var(--navy);
        color: #fff;
        border-radius: 18px;
        padding: 36px;
    }

    .page-info-card h2 {
        color: #fff;
        font-size: 24px;
        margin-bottom: 6px;
    }

    .page-info-card .info-subtitle {
        color: #b6c7dc;
        margin-bottom: 28px;
        font-size: 15px;
    }

    .page-info-card .info-item {
        display: flex;
        gap: 16px;
        margin-bottom: 24px;
        align-items: flex-start;
    }

    .page-info-card .info-icon {
        width: 44px;
        height: 44px;
        min-width: 44px;
        border-radius: 12px;
        background: rgba(245, 166, 35, 0.15);
        color: var(--gold);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .page-info-card .info-text h3 {
        font-size: 16px;
        font-weight: 700;
        margin: 0 0 4px;
        color: #fff;
    }

    .page-info-card .info-text p {
        font-size: 14px;
        color: #b6c7dc;
        margin: 0;
        line-height: 1.5;
    }

    .page-info-card .details-box {
        background: rgba(255,255,255,0.06);
        border-radius: 12px;
        padding: 20px;
        margin-top: 24px;
        border: 1px solid rgba(255,255,255,0.08);
    }

    .page-info-card .details-box h3 {
        font-size: 15px;
        font-weight: 700;
        margin: 0 0 10px;
        color: var(--gold);
    }

    .page-info-card .details-box li {
        color: #cfdcee;
        margin: 8px 0 8px 16px;
        font-size: 14px;
        line-height: 1.5;
    }

    .page-form-card {
        background: #fff;
        border: 2px solid var(--ln);
        border-radius: 18px;
        padding: 36px;
        box-shadow: 0 8px 32px rgba(11, 58, 110, 0.08);
    }

    .page-form-card h2 {
        font-size: 24px;
        margin-bottom: 4px;
        color: var(--navy);
    }

    .page-form-card .form-subtitle {
        color: var(--mu);
        margin-bottom: 20px;
        font-size: 15px;
    }

    .page-form-card label {
        display: block;
        font-weight: 600;
        font-size: 14px;
        margin: 14px 0 4px;
        color: var(--tx);
    }

    .page-form-card input,
    .page-form-card select,
    .page-form-card textarea {
        width: 100%;
        padding: 13px 16px;
        border: 1px solid var(--ln);
        border-radius: 10px;
        font: inherit;
        background: var(--card);
        color: var(--tx);
        transition: border-color 0.2s;
    }

    .page-form-card input:focus,
    .page-form-card select:focus,
    .page-form-card textarea:focus {
        outline: none;
        border-color: var(--gold);
    }

    .page-form-card .two {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    .page-form-card .submit-btn {
        width: 100%;
        margin-top: 20px;
        padding: 16px;
        font-size: 16px;
        font-weight: 700;
        background: var(--navy);
        color: #fff;
        border: none;
        border-radius: 12px;
        cursor: pointer;
        transition: background 0.2s, transform 0.1s;
    }

    .page-form-card .submit-btn:hover {
        background: var(--navy2);
        transform: translateY(-1px);
    }

    @media (max-width: 800px) {
        .page-layout {
            grid-template-columns: 1fr;
            gap: 24px;
            padding: 28px 0;
        }
    }
</style>

<!-- Compact Hero Strip -->
<div class="page-hero-compact">
    <div class="w">
        <div class="tag">JOBS</div>
        <h1>Post a job. <span>Get quotes.</span></h1>
        <p>Describe your project, and TopLine-verified providers will bid. Pick the best.</p>
    </div>
</div>

<section>
    <div class="w">
        <div class="page-layout">
            <!-- LEFT: How It Works -->
            <div class="page-info-card">
                <h2>How It Works</h2>
                <p class="info-subtitle">Get your project done in 3 simple steps</p>

                <div class="info-item">
                    <div class="info-icon"><i class="fas fa-edit"></i></div>
                    <div class="info-text">
                        <h3>1. Describe Your Job</h3>
                        <p>Tell us what you need — cleaning, construction, plumbing, electrical, painting or repairs.</p>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon"><i class="fas fa-users"></i></div>
                    <div class="info-text">
                        <h3>2. Get Matched</h3>
                        <p>Vetted providers in your area see your job and send competitive quotes directly to you.</p>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon"><i class="fas fa-handshake"></i></div>
                    <div class="info-text">
                        <h3>3. Pick & Pay Safely</h3>
                        <p>Choose the best quote, and pay securely via M-PESA escrow — released when the job is done.</p>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon"><i class="fas fa-shield-halved"></i></div>
                    <div class="info-text">
                        <h3>100% Protected</h3>
                        <p>All providers are verified. Your money is held safely until you confirm the work is complete.</p>
                    </div>
                </div>

                <div class="details-box">
                    <h3><i class="fas fa-list-check"></i> Job Categories</h3>
                    <ul>
                        <li>Cleaning — homes, offices, post-construction</li>
                        <li>Construction — building, renovations, extensions</li>
                        <li>Plumbing & Electrical — installations & repairs</li>
                        <li>Painting, Repairs & General maintenance</li>
                    </ul>
                </div>
            </div>

            <!-- RIGHT: Post a Job Form -->
            <div class="page-form-card">
                <h2><i class="fas fa-briefcase" style="color:var(--gold);margin-right:8px"></i> Post Your Job</h2>
                <p class="form-subtitle">Providers in your area will see it and send you quotes.</p>

                <form onsubmit="return send(event,'Job post','Job posted. Providers will contact you with quotes.')">
                    <label>Full name *</label>
                    <input name="Name" type="text" placeholder="Enter your full name" required>

                    <div class="two">
                        <div>
                            <label>Phone / WhatsApp *</label>
                            <input name="Phone" type="tel" placeholder="0712345678" required>
                        </div>
                        <div>
                            <label>Area / town *</label>
                            <input name="Location" type="text" placeholder="e.g. Nairobi" required>
                        </div>
                    </div>

                    <label>Job category *</label>
                    <select name="Category" required>
                        <option>Cleaning</option>
                        <option>Construction</option>
                        <option>Plumbing</option>
                        <option>Electrical</option>
                        <option>Painting</option>
                        <option>Repairs</option>
                        <option>Other</option>
                    </select>

                    <label>Job description *</label>
                    <textarea name="Description" rows="4" placeholder="Describe the work that needs doing" required></textarea>

                    <label>Budget (KSh)</label>
                    <input name="Budget" type="text" placeholder="e.g. 10,000 or negotiable">

                    <button class="submit-btn" type="submit">
                        <i class="fas fa-paper-plane"></i> Post Job
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>


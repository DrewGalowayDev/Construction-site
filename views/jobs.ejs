<!-- PAYSTACK INLINE POPUP & CLIENT JAVASCRIPT: REALTIME FILTERING, AUTH, AND REALTIME PAYMENTS -->
<script src="https://js.paystack.co/v1/inline.js"></script>
<script>
// State variables
let currentTradeFilter = 'all';
let currentLocationFilter = '';
let paymentPollInterval = null;

// Tab switcher
window.showAuthTab = function(tabName) {
  const tabs = ['signin', 'signup', 'postjob'];
  tabs.forEach(t => {
    const btn = document.getElementById('tab-btn-' + t);
    const panel = document.getElementById('auth-panel-' + t);
    if (btn && panel) {
      if (t === tabName) {
        btn.classList.add('active');
        panel.style.display = 'block';
      } else {
        btn.classList.remove('active');
        panel.style.display = 'none';
      }
    }
  });
};

// Password toggle helper (Zero emojis)
window.togglePasswordVisibility = function(inputId, btn) {
  const input = document.getElementById(inputId);
  if (!input) return;
  if (input.type === 'password') {
    input.type = 'text';
    btn.innerHTML = '<i class="fas fa-eye-slash"></i>';
  } else {
    input.type = 'password';
    btn.innerHTML = '<i class="fas fa-eye"></i>';
  }
};

// Quick Fill Demo User
window.fillDemoUser = function(phone, pass) {
  const phoneEl = document.getElementById('signin-phone');
  const passEl = document.getElementById('signin-pass');
  if (phoneEl) phoneEl.value = phone;
  if (passEl) passEl.value = pass;
  showToast('signin-toast', 'Demo credentials loaded! Click Sign In.', 'success');
};

// Toast helper
function showToast(elId, msg, type = 'success') {
  const t = document.getElementById(elId);
  if (!t) return;
  t.textContent = msg;
  t.className = 'toast ' + type;
  t.style.display = 'block';
  setTimeout(() => {
    t.style.display = 'none';
  }, 5000);
}

// 1. REALTIME FILTERING: TRADE & LOCATION
function filterByTrade(trade) {
  currentTradeFilter = trade;
  
  // Update chip active classes
  const chips = document.querySelectorAll('#chips .chip');
  chips.forEach(c => {
    const text = c.textContent.toLowerCase();
    if (trade === 'all' && text.includes('all')) {
      c.classList.add('on');
    } else if (trade !== 'all' && text.includes(trade.toLowerCase())) {
      c.classList.add('on');
    } else {
      c.classList.remove('on');
    }
  });

  applyFilters();
}

function filterByLocation(loc) {
  const input = document.getElementById('locSearchInput');
  if (loc === 'All Locations') {
    currentLocationFilter = '';
    if (input) input.value = '';
  } else {
    currentLocationFilter = loc;
    if (input) input.value = loc;
  }

  // Update pill active state
  const pills = document.querySelectorAll('.loc-pill');
  pills.forEach(p => {
    if ((loc === 'All Locations' && p.textContent.includes('All')) || p.textContent.includes(loc)) {
      p.classList.add('active');
    } else {
      p.classList.remove('active');
    }
  });

  applyFilters();
}

function onRealtimeLocationInput(val) {
  currentLocationFilter = val.trim();
  
  // Clear active state of quick pills if typing custom location
  const pills = document.querySelectorAll('.loc-pill');
  pills.forEach(p => p.classList.remove('active'));

  applyFilters();
}

function resetFilters() {
  currentTradeFilter = 'all';
  currentLocationFilter = '';
  const input = document.getElementById('locSearchInput');
  if (input) input.value = '';
  filterByTrade('all');
  filterByLocation('All Locations');
}

// Client-side instant filter on existing cards + API sync
function applyFilters() {
  const cards = document.querySelectorAll('#list .job-card-col');
  let visibleCount = 0;

  const tTerm = currentTradeFilter.toLowerCase();
  const lTerm = currentLocationFilter.toLowerCase();

  cards.forEach(card => {
    const cardTrade = (card.getAttribute('data-trade') || '').toLowerCase();
    const cardLoc = (card.getAttribute('data-location') || '').toLowerCase();
    const cardTitle = (card.getAttribute('data-title') || '').toLowerCase();

    const tradeMatch = (currentTradeFilter === 'all') || cardTrade.includes(tTerm) || cardTitle.includes(tTerm);
    const locMatch = (!currentLocationFilter) || cardLoc.includes(lTerm) || cardTitle.includes(lTerm);

    if (tradeMatch && locMatch) {
      card.style.display = 'flex';
      visibleCount++;
    } else {
      card.style.display = 'none';
    }
  });

  // Update status count
  const countBadge = document.getElementById('jobCountBadge');
  const countLabel = document.getElementById('jobCountLabel');
  if (countBadge) countBadge.textContent = visibleCount;
  if (countLabel) {
    if (currentLocationFilter) {
      countLabel.textContent = `Verified opportunities in "${currentLocationFilter}"`;
    } else if (currentTradeFilter !== 'all') {
      countLabel.textContent = `Verified opportunities for "${currentTradeFilter}"`;
    } else {
      countLabel.textContent = `Verified opportunities available`;
    }
  }
}

// 2. QUICK WORKER SIGN IN VIA API
async function handleWorkerSignIn(e) {
  e.preventDefault();
  const phone = document.getElementById('signin-phone').value;
  const pass = document.getElementById('signin-pass').value;
  const btn = document.getElementById('btn-signin');
  const original = btn.innerHTML;

  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Signing in...';

  try {
    const res = await fetch('/api/jobs/auth/signin', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ phoneOrEmail: phone, password: pass })
    });
    const data = await res.json();
    if (data.success) {
      showToast('signin-toast', data.message || 'Signed in successfully!', 'success');
      setTimeout(() => {
        window.location.reload();
      }, 1000);
    } else {
      showToast('signin-toast', data.message || 'Invalid credentials.', 'error');
    }
  } catch (err) {
    showToast('signin-toast', 'Connection error. Please try again.', 'error');
  } finally {
    btn.disabled = false;
    btn.innerHTML = original;
  }
}

// 3. WORKER ACTIVATION: REALTIME PAYMENT
async function handleWorkerActivationPayment(e) {
  e.preventDefault();
  const form = e.target;
  const btn = document.getElementById('btn-worker-pay');
  const original = btn.innerHTML;

  const payload = {
    name: document.getElementById('reg-name').value,
    phone: document.getElementById('reg-phone').value,
    email: document.getElementById('reg-email').value,
    password: document.getElementById('reg-pass').value,
    trade: document.getElementById('reg-trade').value,
    preferred_country: document.getElementById('reg-country').value
  };

  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Initializing M-Pesa Payment...';

  try {
    const res = await fetch('/api/jobs/payment/initialize', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    const data = await res.json();

    if (data.success) {
      openPayModal(data.reference, data.authorization_url, data.isSimulated);
      
      const paystackKey = '<%= paystackPublicKey %>';
      if (window.PaystackPop && paystackKey && paystackKey.length > 10 && !data.isSimulated) {
        try {
          const handler = PaystackPop.setup({
            key: paystackKey,
            email: payload.email || `worker_${payload.phone.replace(/\D/g, '')}@toplinehub.co.ke`,
            amount: 1000 * 100,
            currency: 'KES',
            ref: data.reference,
            metadata: {
              custom_fields: [
                { display_name: "Mobile Number", variable_name: "mobile_number", value: payload.phone },
                { display_name: "Worker Name", variable_name: "worker_name", value: payload.name },
                { display_name: "Trade", variable_name: "trade", value: payload.trade }
              ]
            },
            callback: function(response) {
              checkRealtimePaymentStatus(data.reference);
            },
            onClose: function() {
              // Modal remains open listening for M-Pesa STK push
            }
          });
          handler.openIframe();
        } catch (popupErr) {
          console.warn('Paystack popup fallback to redirect:', popupErr);
          if (data.authorization_url) window.open(data.authorization_url, '_blank');
        }
      } else if (data.authorization_url && !data.isSimulated) {
        window.open(data.authorization_url, '_blank');
      }
    } else {
      showToast('signup-toast', data.message || 'Payment initialization failed.', 'error');
    }
  } catch (err) {
    showToast('signup-toast', 'Network error. Please try again.', 'error');
  } finally {
    btn.disabled = false;
    btn.innerHTML = original;
  }
}

function openPayModal(ref, authUrl, isSimulated) {
  const modal = document.getElementById('payModal');
  const refEl = document.getElementById('payModalRef');
  const extBtn = document.getElementById('payModalExternalBtn');
  const subtext = document.getElementById('payModalSubtext');

  if (refEl) refEl.textContent = ref;
  if (extBtn) extBtn.href = authUrl || 'javascript:void(0)';
  if (modal) modal.style.display = 'flex';

  if (isSimulated && subtext) {
    subtext.innerHTML = '<em>Simulation Mode:</em> Verifying demo payment automatically in a few seconds...';
  } else if (subtext) {
    subtext.innerHTML = 'Secure Paystack checkout initiated. Complete payment via <strong>M-Pesa</strong> or Card to activate immediately.';
  }

  // Start polling backend verification every 2 seconds
  if (paymentPollInterval) clearInterval(paymentPollInterval);
  paymentPollInterval = setInterval(() => {
    checkRealtimePaymentStatus(ref);
  }, 2000);
}

function closePayModal() {
  const modal = document.getElementById('payModal');
  if (modal) modal.style.display = 'none';
  if (paymentPollInterval) {
    clearInterval(paymentPollInterval);
    paymentPollInterval = null;
  }
}

async function checkRealtimePaymentStatus(ref) {
  try {
    const res = await fetch(`/api/jobs/payment/verify?reference=${encodeURIComponent(ref)}`);
    const data = await res.json();

    if (data.success && data.completed) {
      if (paymentPollInterval) clearInterval(paymentPollInterval);
      
      const statusEl = document.getElementById('payModalStatus');
      const spinnerEl = document.getElementById('payModalSpinner');
      if (statusEl) {
        statusEl.textContent = 'Payment Confirmed!';
        statusEl.style.color = '#10b981';
      }
      if (spinnerEl) {
        spinnerEl.innerHTML = '<div style="color:#10b981;font-weight:800;font-size:16px"><i class="fas fa-check-circle" style="font-size:36px"></i><br>Profile Activated! Unlocking Jobs...</div>';
      }

      setTimeout(() => {
        closePayModal();
        window.location.reload();
      }, 1500);
    }
  } catch (e) {
    console.warn('Polling check error:', e);
  }
}

function promptWorkerUnlock(jobTitle) {
  showAuthTab('signup');
  const joinSec = document.getElementById('join');
  if (joinSec) joinSec.scrollIntoView({ behavior: 'smooth' });
  showToast('signup-toast', `Activate your profile (KSh 1,000) to apply for "${jobTitle}"`, 'success');
}

// 4. POST A JOB SUBMISSION
async function handleClientJobPost(e) {
  e.preventDefault();
  const form = e.target;
  const btn = document.getElementById('btn-post-job');
  const original = btn.innerHTML;

  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Publishing to Platform...';

  const formData = new FormData(form);
  const payload = {};
  formData.forEach((val, key) => { payload[key] = val; });

  try {
    const res = await fetch('/jobs/create', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    const data = await res.json();

    if (data.success) {
      showToast('postjob-toast', data.message || 'Job posted successfully!', 'success');
      form.reset();

      // Prepend new job to 4-column grid in realtime
      if (data.job) {
        prependJobToList(data.job);
        document.getElementById('jobs').scrollIntoView({ behavior: 'smooth' });
      }
    } else {
      showToast('postjob-toast', data.message || 'Failed to post job.', 'error');
    }
  } catch (err) {
    showToast('postjob-toast', 'Connection error. Please try again.', 'error');
  } finally {
    btn.disabled = false;
    btn.innerHTML = original;
  }
}

function prependJobToList(j) {
  const list = document.getElementById('list');
  if (!list) return;

  const card = document.createElement('div');
  card.className = 'job-card-col';
  card.setAttribute('data-trade', j.trade_required || '');
  card.setAttribute('data-location', `${j.location_town}, ${j.location_county}`);
  card.setAttribute('data-title', j.title || '');
  card.style.border = '2px solid var(--gold)';

  card.innerHTML = `
    <div>
      <div class="job-card-top">
        <span class="trade-tag"><i class="fas fa-tag"></i> ${escapeHtml(j.trade_required)}</span>
        <span class="ok-badge"><i class="fas fa-check-circle"></i> Verified</span>
      </div>
      <h3 class="job-card-title">${escapeHtml(j.title)}</h3>
      <p class="job-card-desc">${escapeHtml(j.description)}</p>
      <div class="job-meta-stack">
        <div class="job-meta-row">
          <span><i class="fas fa-map-marker-alt" style="color:var(--navy);margin-right:4px"></i> ${escapeHtml(j.location_town)}, ${escapeHtml(j.location_county)}</span>
        </div>
        <div class="job-meta-row">
          <span class="salary-tag">KSh ${Number(j.budget_estimate || 0).toLocaleString()}</span>
          <span><i class="far fa-clock"></i> ${escapeHtml(j.duration || '2 weeks')}</span>
        </div>
      </div>
    </div>
    <div>
      <a class="btn s navy" href="/jobs/${j.id}" style="width:100%">
        <i class="fas fa-check-circle"></i> View / Apply
      </a>
    </div>
  `;

  list.insertBefore(card, list.firstChild);
  applyFilters();
}

function escapeHtml(str) {
  if (!str) return '';
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

// Check URL query parameters for payment return
document.addEventListener('DOMContentLoaded', () => {
  const urlParams = new URLSearchParams(window.location.search);
  const ref = urlParams.get('reference');
  if (ref && urlParams.get('payment_status') === 'check') {
    openPayModal(ref, null, false);
  }
});
</script>


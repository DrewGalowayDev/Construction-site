<%- include('partials/header') %>
<%- include('partials/nav') %>

<header class="hero s">
    <div class="w">
        <div class="tag">PROVIDERS</div>
        <h1>Get a provider, or <span>become one</span></h1>
        <p>Customers: tell us what you need. Professionals: join TopLine and get jobs.</p>
    </div>
</header>

<% if (providers && providers.length > 0) { %>
<section>
    <div class="w">
        <h2 style="text-align:center">Verified Service Providers</h2>
        <p class="sub" style="text-align:center">Trusted professionals ready for your project</p>
        <div class="grid">
            <% providers.forEach(provider => { %>
            <div class="c">
                <div class="ic" style="background:#f5a623;color:#07284f"><i class="fas fa-user-tie"></i></div>
                <% if (provider.user) { %>
                <b><%= provider.user.name %></b>
                <% } %>
                <p class="sub" style="margin:4px 0 0"><i class="fas fa-wrench"></i> <%= provider.trade || 'Service provider' %></p>
                <% if (provider.experience_years) { %>
                <p class="sub" style="margin:4px 0 0;font-size:12px"><i class="fas fa-calendar-alt"></i> <%= provider.experience_years %> years experience</p>
                <% } %>
                <% if (provider.daily_rate) { %>
                <p style="margin-top:8px;font-weight:700;color:var(--gold)"><i class="fas fa-money-bill-wave"></i> KSh <%= provider.daily_rate.toLocaleString() %>/day</p>
                <% } %>
                <% if (provider.is_available) { %>
                <p class="sub" style="margin:2px 0 0;font-size:12px;color:#28a745"><i class="fas fa-check-circle"></i> Available</p>
                <% } %>
            </div>
            <% }) %>
        </div>
    </div>
</section>
<% } else { %>
<section>
    <div class="w" style="text-align:center;padding:60px 20px">
        <i class="fas fa-users" style="font-size:48px;color:var(--mu);margin-bottom:20px"></i>
        <h2>No providers listed yet</h2>
        <p class="sub">Be the first to join as a verified service provider!</p>
    </div>
</section>
<% } %>

<section class="alt">
    <div class="w">
        <h2 style="text-align:center">I need a provider</h2>
        <p class="sub" style="text-align:center">We will match you with a vetted professional.</p>
        <form class="fm" onsubmit="return send(event,'Provider request','Request sent. We will contact you shortly.')">
            <label>Full name</label>
            <input name="Name" type="text" placeholder="" required>
            
            <div class="two">
                <div>
                    <label>Phone / WhatsApp</label>
                    <input name="Phone" type="tel" placeholder="" required>
                </div>
                <div>
                    <label>Area / town</label>
                    <input name="Location" type="text" placeholder="" required>
                </div>
            </div>
            
            <label>Service needed</label>
            <select name="Service" required>
                <option>Cleaning</option>
                <option>Construction</option>
                <option>Plumbing</option>
                <option>Electrical</option>
                <option>Painting</option>
                <option>Repairs</option>
                <option>Other</option>
            </select>
            
            <label>What needs doing?</label>
            <textarea name="Details" rows="3" placeholder="Describe the work" required></textarea>
            
            <div style="height:16px"></div>
            <button class="btn n" style="width:100%">Request a provider</button>
        </form>
    </div>
</section>

<section>
    <div class="w">
        <h2 style="text-align:center">I am a service provider</h2>
        <p class="sub" style="text-align:center">Join TopLine to get verified and receive jobs.</p>
        <form class="fm" onsubmit="return send(event,'Provider application','Application sent. We will be in touch to verify you.')">
            <label>Full name</label>
            <input name="Name" type="text" placeholder="" required>
            
            <div class="two">
                <div>
                    <label>Phone / WhatsApp</label>
                    <input name="Phone" type="tel" placeholder="" required>
                </div>
                <div>
                    <label>Area / town</label>
                    <input name="Location" type="text" placeholder="" required>
                </div>
            </div>
            
            <label>Main skill</label>
            <select name="Skill" required>
                <option>Cleaning</option>
                <option>Construction</option>
                <option>Plumbing</option>
                <option>Electrical</option>
                <option>Painting</option>
                <option>Repairs</option>
                <option>Other</option>
            </select>
            
            <label>Years of experience</label>
            <input name="Experience" type="number" placeholder="e.g. 5" required>
            
            <label>About your work</label>
            <textarea name="About" rows="3" placeholder="Past jobs, tools, certifications"></textarea>
            
            <div style="height:16px"></div>
            <button class="btn n" style="width:100%">Apply to join</button>
        </form>
    </div>
</section>

<%- include('partials/footer') %>

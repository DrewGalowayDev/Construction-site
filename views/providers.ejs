<script>
    function switchProviderTab(type) {
        const formNeed = document.getElementById('formNeedProvider');
        const formJoin = document.getElementById('formJoinProvider');
        const tabNeed = document.getElementById('tabNeed');
        const tabJoin = document.getElementById('tabJoin');

        if (type === 'need') {
            formNeed.style.display = 'block';
            formJoin.style.display = 'none';
            tabNeed.classList.add('active');
            tabJoin.classList.remove('active');
        } else {
            formNeed.style.display = 'none';
            formJoin.style.display = 'block';
            tabNeed.classList.remove('active');
            tabJoin.classList.add('active');
        }
    }
</script>

<%- include('partials/footer') %>
